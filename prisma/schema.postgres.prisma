// =============================================================================
// Sentinel — Prisma Schema (Production: PostgreSQL + PostGIS)
// =============================================================================
// This is the PRODUCTION schema. It targets PostgreSQL with the PostGIS
// extension for geospatial data.
//
// Usage (production):
//   DATABASE_URL=postgresql://sentinel:****@postgres:5432/sentinel
//   DATABASE_PROVIDER=postgresql
//   npx prisma db push --schema=prisma/schema.postgres.prisma
//   psql ... -f prisma/sql/postgis.sql   # adds geometry columns + spatial indexes
//
// Geometry columns (GeomFromText, ST_DWithin, etc.) are created via raw SQL in
// prisma/sql/postgis.sql because Prisma has no native PostGIS type. Repositories
// access them through typed raw-query helpers (see infrastructure/storage &
// future modules/intelligence).
//
// The relational models are identical to the SQLite dev schema so application
// code is portable between environments.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IAM
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  status        String    @default("active")
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  userRoles     UserRole[]
  auditLogs     AuditLog[]
  createdFlags  FeatureFlag[]  @relation("FlagCreatedBy")
  updatedFlags  FeatureFlag[]  @relation("FlagUpdatedBy")

  @@index([status])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@index([key])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime  @default(now())
  assignedBy String?
  expiresAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  actorId     String?
  actorType   String   @default("user")
  action      String
  resource    String
  resourceId  String?
  outcome     String   @default("success")
  ipAddress   String?
  userAgent   String?
  requestId   String?
  metadata    String?
  hash        String?
  prevHash    String?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([actorId])
  @@index([action])
  @@index([resource, resourceId])
}

// ---------------------------------------------------------------------------
// Feature Flags
// ---------------------------------------------------------------------------

model FeatureFlag {
  id                String    @id @default(cuid())
  key               String    @unique
  name              String
  description       String?
  enabled           Boolean   @default(false)
  rolloutPercentage Int       @default(0)
  strategy          String    @default("boolean")
  config            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?
  updatedById       String?

  createdBy User? @relation("FlagCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("FlagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  segments  FeatureFlagSegment[]

  @@index([enabled])
  @@index([key])
}

model FeatureFlagSegment {
  id       String @id @default(cuid())
  flagId   String
  name     String
  rule     String
  priority Int    @default(0)

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId])
}

// ---------------------------------------------------------------------------
// Outbox
// ---------------------------------------------------------------------------

model OutboxEvent {
  id            String   @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       String
  metadata      String?
  occurredAt    DateTime @default(now())
  status        String   @default("pending")
  attempts      Int      @default(0)
  lastError     String?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([status, occurredAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType])
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

model JobRecord {
  id          String    @id @default(cuid())
  queue       String
  name        String
  payload     String
  status      String    @default("queued")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([queue])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Object Storage
// ---------------------------------------------------------------------------

model StoredObject {
  id          String   @id @default(cuid())
  key         String   @unique
  bucket      String   @default("default")
  provider    String
  contentType String?
  size        Int      @default(0)
  checksum    String?
  ownerType   String?
  ownerId     String?
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bucket, key])
  @@index([ownerType, ownerId])
}

// ---------------------------------------------------------------------------
// Health
// ---------------------------------------------------------------------------

model HealthCheckResult {
  id        String   @id @default(cuid())
  checkName String
  status    String
  latencyMs Int
  message   String?
  checkedAt DateTime @default(now())

  @@index([checkName, checkedAt])
}

// ---------------------------------------------------------------------------
// PostGIS — Geospatial extension tables (future milestones)
// ---------------------------------------------------------------------------
// The following tables are placeholders for the Intelligence, Cases, and
// Digital-Twin bounded contexts (Milestones 2+). Geometry columns are created
// via raw SQL in prisma/sql/postgis.sql. They are declared here so the
// production schema documents the spatial model up front.
// ---------------------------------------------------------------------------

model Incident {
  id          String   @id @default(cuid())
  reference   String   @unique
  title       String
  status      String   @default("open") // open | investigating | verified | resolved | false_positive
  severity    String   @default("medium") // low | medium | high | critical
  // geometry columns (geo_point, geo_polygon) added via postgis.sql — Unsupported type.
  geoPoint    Unsupported("geography(Point,4326)")?
  geoPolygon  Unsupported("geography(Polygon,4326)")?
  country     String?
  region      String?
  reportedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([country])
}

model Report {
  id          String   @id @default(cuid())
  incidentId  String?
  sourceType  String   // citizen | satellite | drone | sensor | partner
  content     String
  // geo_point added via postgis.sql
  geoPoint    Unsupported("geography(Point,4326)")?
  confidence  Float    @default(0)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([sourceType])
  @@index([verified])
  @@index([incidentId])
}
