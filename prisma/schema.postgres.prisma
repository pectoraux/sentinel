  metadata        String?
  createdAt       DateTime @default(now())

  @@unique([userId, subscriptionType, target])
  @@index([userId])
  @@index([subscriptionType])
  @@index([isActive])
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  type            String
  title           String
  body            String
  priority        Int      @default(1)
  channels        String   @default("[\"in_app\"]")
  data            String?
  isRead          Boolean  @default(false)
  readAt          DateTime?
  deliveryStatus  String?
  source          String   @default("system")
  matchedGeofence String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([priority])
  @@index([isRead])
  @@index([createdAt])
}

model NotificationDigest {
  id              String   @id @default(cuid())
  userId          String
  period          String
  startTime       DateTime
  endTime         DateTime
  notificationIds String
  count           Int      @default(0)
  status          String   @default("pending")
  sentAt          DateTime?
  channels        String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([period])
}

model GeofenceSubscription {
  id              String   @id @default(cuid())
  userId          String
  name            String
  geojson         String
  centerLat       Float
  centerLng       Float
  radiusM         Float?
  channels        String   @default("[\"push\",\"in_app\"]")
  minPriority     Int      @default(1)
  eventTypes      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([isActive])
  @@index([centerLat, centerLng])
}

model SatelliteScene {
  id              String   @id @default(cuid())
  sceneId         String   @unique
  satellite       String
  sensor          String
  acquisitionDate DateTime
  cloudCover      Float    @default(0)
  sunAzimuth      Float?
  sunElevation    Float?
  crs             String   @default("EPSG:4326")
  bbox            String
  centerLat       Float
  centerLng       Float
  resolutionM     Float    @default(10)
  status          String   @default("scheduled")
  processingStage String   @default("pending")
  rawStorageKey   String?
  tiledStorageKey String?
  thumbnailKey    String?
  sizeBytes       Int      @default(0)
  bands           String?
  metadata        String?
  scheduledById   String?
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tiles           RasterTile[]
  schedule        IngestionSchedule?

  @@index([satellite])
  @@index([status])
  @@index([acquisitionDate])
  @@index([centerLat, centerLng])
  @@index([cloudCover])
}

model RasterTile {
  id              String   @id @default(cuid())
  sceneId         String
  z               Int
  x               Int
  y               Int
  quadkey         String
  storageKey      String
  sizeBytes       Int      @default(0)
  contentType     String   @default("image/png")
  cacheStatus     String   @default("pending")
  cachedAt        DateTime?
  expiresAt       DateTime?
  accessCount     Int      @default(0)
  lastAccessedAt  DateTime?
  bands           String?
  checksum        String?
  createdAt       DateTime @default(now())

  scene           SatelliteScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([sceneId, z, x, y])
  @@index([sceneId, z])
  @@index([cacheStatus])
  @@index([quadkey])
  @@index([z, x, y])
}

model IngestionSchedule {
  id              String   @id @default(cuid())
  name            String
  satellite       String
  bbox            String
  centerLat       Float
  centerLng       Float
  frequency       String   @default("weekly")
