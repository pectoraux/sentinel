// =============================================================================
// Sentinel — Prisma Schema (Production: PostgreSQL + PostGIS)
// =============================================================================
// This is the PRODUCTION schema. It targets PostgreSQL with the PostGIS
// extension for geospatial data.
//
// Usage (production):
//   DATABASE_URL=postgresql://sentinel:****@postgres:5432/sentinel
//   DATABASE_PROVIDER=postgresql
//   npx prisma db push --schema=prisma/schema.postgres.prisma
//   psql ... -f prisma/sql/postgis.sql   # adds geometry columns + spatial indexes
//
// Geometry columns (GeomFromText, ST_DWithin, etc.) are created via raw SQL in
// prisma/sql/postgis.sql because Prisma has no native PostGIS type. Repositories
// access them through typed raw-query helpers (see infrastructure/storage &
// future modules/intelligence).
//
// The relational models are identical to the SQLite dev schema so application
// code is portable between environments.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IAM
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  status        String    @default("active")
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  userRoles     UserRole[]
  auditLogs     AuditLog[]
  createdFlags  FeatureFlag[]  @relation("FlagCreatedBy")
  updatedFlags  FeatureFlag[]  @relation("FlagUpdatedBy")
  orgMemberships OrganizationMember[]
  orgVerifiedBy  Organization[]  @relation("OrgVerifiedBy")
  devices        Device[]
  verifications  IdentityVerification[]
  trustProfile   TrustProfile?
  trustEvents    TrustEvent[]
  roleSwitches   RoleSwitchLog[]
  activeRole     ActiveRole?
  invitedOrgs    OrganizationInvitation[]  @relation("InvitedBy")

  @@index([status])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@index([key])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime  @default(now())
  assignedBy String?
  expiresAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  actorId     String?
  actorType   String   @default("user")
  action      String
  resource    String
  resourceId  String?
  outcome     String   @default("success")
  ipAddress   String?
  userAgent   String?
  requestId   String?
  metadata    String?
  hash        String?
  prevHash    String?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([actorId])
  @@index([action])
  @@index([resource, resourceId])
}

// ---------------------------------------------------------------------------
// Feature Flags
// ---------------------------------------------------------------------------

model FeatureFlag {
  id                String    @id @default(cuid())
  key               String    @unique
  name              String
  description       String?
  enabled           Boolean   @default(false)
  rolloutPercentage Int       @default(0)
  strategy          String    @default("boolean")
  config            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?
  updatedById       String?

  createdBy User? @relation("FlagCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("FlagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  segments  FeatureFlagSegment[]

  @@index([enabled])
  @@index([key])
}

model FeatureFlagSegment {
  id       String @id @default(cuid())
  flagId   String
  name     String
  rule     String
  priority Int    @default(0)

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId])
}

// ---------------------------------------------------------------------------
// Outbox
// ---------------------------------------------------------------------------

model OutboxEvent {
  id            String   @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       String
  metadata      String?
  occurredAt    DateTime @default(now())
  status        String   @default("pending")
  attempts      Int      @default(0)
  lastError     String?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([status, occurredAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType])
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

model JobRecord {
  id          String    @id @default(cuid())
  queue       String
  name        String
  payload     String
  status      String    @default("queued")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([queue])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Object Storage
// ---------------------------------------------------------------------------

model StoredObject {
  id          String   @id @default(cuid())
  key         String   @unique
  bucket      String   @default("default")
  provider    String
  contentType String?
  size        Int      @default(0)
  checksum    String?
  ownerType   String?
  ownerId     String?
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bucket, key])
  @@index([ownerType, ownerId])
}

// ---------------------------------------------------------------------------
// Health
// ---------------------------------------------------------------------------

model HealthCheckResult {
  id        String   @id @default(cuid())
  checkName String
  status    String
  latencyMs Int
  message   String?
  checkedAt DateTime @default(now())

  @@index([checkName, checkedAt])
}

// ---------------------------------------------------------------------------
// PostGIS — Geospatial extension tables (future milestones)
// ---------------------------------------------------------------------------
// The following tables are placeholders for the Intelligence, Cases, and
// Digital-Twin bounded contexts (Milestones 2+). Geometry columns are created
// via raw SQL in prisma/sql/postgis.sql. They are declared here so the
// production schema documents the spatial model up front.
// ---------------------------------------------------------------------------

model Incident {
  id          String   @id @default(cuid())
  reference   String   @unique
  title       String
  status      String   @default("open") // open | investigating | verified | resolved | false_positive
  severity    String   @default("medium") // low | medium | high | critical
  // geometry columns (geo_point, geo_polygon) added via postgis.sql — Unsupported type.
  geoPoint    Unsupported("geography(Point,4326)")?
  geoPolygon  Unsupported("geography(Polygon,4326)")?
  country     String?
  region      String?
  reportedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([country])
}

model Report {
  id          String   @id @default(cuid())
  incidentId  String?
  sourceType  String   // citizen | satellite | drone | sensor | partner
  content     String
  // geo_point added via postgis.sql
  geoPoint    Unsupported("geography(Point,4326)")?
  confidence  Float    @default(0)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([sourceType])
  @@index([verified])
  @@index([incidentId])
}

// =============================================================================
// MILESTONE 2 — Identity & Trust Platform
// =============================================================================

model Organization {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  type        String   // government_agency | ngo | researcher | regulator | community
  country     String?
  region      String?
  description String?
  logoUrl     String?
  status      String   @default("pending_verification")
  verifiedAt  DateTime?
  verifiedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  verifier    User? @relation("OrgVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  devices     Device[]
  verifications IdentityVerification[]

  @@index([type])
  @@index([status])
  @@index([country])
}

model OrganizationMember {
  id            String   @id @default(cuid())
  organizationId String
  userId        String
  role          String   @default("member")
  joinedAt      DateTime @default(now())
  invitedBy     String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model OrganizationInvitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String   @default("member")
  token          String   @unique
  invitedById    String
  status         String   @default("pending")
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User          @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status])
}

model Device {
  id            String   @id @default(cuid())
  userId        String
  organizationId String?
  fingerprint   String   @unique
  label         String?
  platform      String?
  userAgent     String?
  status        String   @default("unverified")
  lastSeenAt    DateTime @default(now())
  lastSeenIp    String?
  location      String?
  trustedAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

model IdentityVerification {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String?
  type            String
  status          String   @default("pending")
  documentReference String?
  submittedData   String?
  reviewerNotes   String?
  reviewedById    String?
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([type])
}

model TrustProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  score           Int      @default(0)
  tier            String   @default("unverified")
  factors         String?
  badges          String?
  lastRecalculatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([score])
  @@index([tier])
}

model TrustEvent {
  id          String   @id @default(cuid())
  userId      String
  type        String
  delta       Int
  reason      String?
  metadata    String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model RoleSwitchLog {
  id          String   @id @default(cuid())
  userId      String
  fromRole    String?
  toRole      String
  contextType String   @default("global")
  contextId   String?
  reason      String?
  ip          String?
  switchedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([switchedAt])
}

model ActiveRole {
  id          String   @id @default(cuid())
  userId      String   @unique
  roleKey     String
  contextType String   @default("global")
  contextId   String?
  setAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================================================================
// MILESTONE 3 — Geospatial Platform (GIS Engine)
// =============================================================================

model PointOfInterest {
  id          String   @id @default(cuid())
  name        String
  type        String
  lat         Float
  lng         Float
  geojson     String?
  layerId     String?
  country     String?
  region      String?
  status      String   @default("active")
  severity    String?
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  layer       GeoLayer? @relation(fields: [layerId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([country])
  @@index([layerId])
  @@index([lng, lat])
}

model SpatialRegion {
  id          String   @id @default(cuid())
  name        String
  type        String
  geojson     String
  bbox        String?
  areaKm2     Float?
  country     String?
  region      String?
  layerId     String?
  status      String   @default("active")
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  layer       GeoLayer? @relation(fields: [layerId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([country])
  @@index([layerId])
}

model GeoLayer {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  type        String
  source      String
  description String?
  visible     Boolean  @default(true)
  zIndex      Int      @default(0)
  opacity     Float    @default(1.0)
  config      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  points      PointOfInterest[]
  regions     SpatialRegion[]

  @@index([type])
  @@index([visible])
}

model GeoTileManifest {
  id          String   @id @default(cuid())
  layerId     String
  z           Int
  x           Int
  y           Int
  status      String   @default("pending")
  etag        String?
  sizeBytes   Int      @default(0)
  cachedAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@unique([layerId, z, x, y])
  @@index([layerId, z])
  @@index([status])
}

// =============================================================================
// MILESTONE 4 — Digital Twin Core
// =============================================================================

model TwinEntity {
  id              String   @id @default(cuid())
  key             String   @unique
  type            String
  name            String
  description     String?
  status          String   @default("active")
  geojson         String?
  lat             Float?
  lng             Float?
  metadata        String?
  currentVersion  Int      @default(1)
  organizationId  String?
  country         String?
  region          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions        TwinEntityVersion[]
  events          TwinEvent[]
  relationshipsFrom TwinRelationship[] @relation("RelFrom")
  relationshipsTo   TwinRelationship[] @relation("RelTo")

  @@index([type])
  @@index([status])
  @@index([country])
  @@index([organizationId])
  @@index([lng, lat])
}

model TwinEntityVersion {
  id              String   @id @default(cuid())
  entityId        String
  version         Int
  snapshot        String
  changeReason    String?
  diff            String?
  changedById     String?
  validFrom       DateTime @default(now())
  validTo         DateTime?
  createdAt       DateTime @default(now())

  entity TwinEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, version])
  @@index([entityId])
  @@index([validFrom])
}

model TwinRelationship {
  id              String   @id @default(cuid())
  fromEntityId    String
  toEntityId      String
  type            String
  strength        Float    @default(1.0)
  metadata        String?
  bidirectional   Boolean  @default(false)
  validFrom       DateTime @default(now())
  validTo         DateTime?
  createdAt       DateTime @default(now())

  fromEntity TwinEntity @relation("RelFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   TwinEntity @relation("RelTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, type])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([type])
}

model TwinEvent {
  id              String   @id @default(cuid())
  entityId        String
  type            String
  title           String
  description     String?
  severity        String   @default("info")
  payload         String?
  source          String?
  sourceType      String   @default("system")
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now())

  entity TwinEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([type])
  @@index([severity])
  @@index([timestamp])
}

// =============================================================================
// MILESTONE 7 — Evidence Platform
// =============================================================================

model Evidence {
  id              String   @id @default(cuid())
  key             String   @unique
  title           String
  description     String?
  type            String
  mediaType       String
  storageKey      String
  storageProvider String   @default("local")
  sizeBytes       Int      @default(0)
  checksum        String
  currentHash     String
  previousHash    String?
  encrypted       Boolean  @default(false)
  encryptionKeyId String?
  lat             Float?
  lng             Float?
  geojson         String?
  metadata        String?
  currentVersion  Int      @default(1)
  uploadedById    String?
  organizationId  String?
  twinEntityId    String?
  verified        Boolean  @default(false)
  verifiedById    String?
  verifiedAt      DateTime?
  chainValid      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions        EvidenceVersion[]
  weight          EvidenceWeight?
  corroborations  Corroboration[]

  @@index([type])
  @@index([mediaType])
  @@index([uploadedById])
  @@index([organizationId])
  @@index([twinEntityId])
  @@index([verified])
  @@index([lat, lng])
}

model EvidenceVersion {
  id              String   @id @default(cuid())
  evidenceId      String
  version         Int
  snapshot        String
  contentHash     String
  metadataHash    String
  combinedHash    String
  previousHash    String?
  changeReason    String?
  diff            String?
  storageKey      String
  sizeBytes       Int
  changedById     String?
  validFrom       DateTime @default(now())
  validTo         DateTime?
  createdAt       DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, version])
  @@index([evidenceId])
  @@index([validFrom])
}

// =============================================================================
// MILESTONE 8 — Community Intelligence (Event-Sourced)
// =============================================================================

model IntelligenceEvent {
  id              String   @id @default(cuid())
  key             String   @unique
  title           String
  description     String?
  type            String
  status          String   @default("open")
  severity        String   @default("medium")
  lat             Float?
  lng             Float?
  locationName    String?
  createdById     String
  organizationId  String?
  twinEntityId    String?
  evidenceIds     String?
  commentCount    Int      @default(0)
  subscriberCount Int      @default(0)
  watcherCount    Int      @default(0)
  shareCount      Int      @default(0)
  viewCount       Int      @default(0)
  streamVersion   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stream          EventStreamEntry[]
  comments        EventComment[]
  subscriptions   EventSubscription[]
  shares          EventShare[]

  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([createdById])
  @@index([organizationId])
  @@index([lat, lng])
  @@index([createdAt])
}

model EventStreamEntry {
  id              String   @id @default(cuid())
  eventId         String
  version         Int
  eventType       String
  actorId         String?
  actorType       String   @default("user")
  payload         String?
  metadata        String?
  timestamp       DateTime @default(now())

  event IntelligenceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, version])
  @@index([eventId])
  @@index([eventType])
  @@index([timestamp])
  @@index([actorId])
}

model EventComment {
  id              String   @id @default(cuid())
  eventId         String
  authorId        String
  body            String
  parentId        String?
  attachments     String?
  edited          Boolean  @default(false)
  editedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event IntelligenceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([authorId])
  @@index([parentId])
}

model EventSubscription {
  id              String   @id @default(cuid())
  eventId         String
  userId          String
  type            String   @default("watch")
  createdAt       DateTime @default(now())

  event IntelligenceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, type])
  @@index([eventId])
  @@index([userId])
}

model EventShare {
  id              String   @id @default(cuid())
  eventId         String
  sharedById      String
  platform        String   @default("internal")
  recipientId     String?
  message         String?
  createdAt       DateTime @default(now())

  event IntelligenceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([sharedById])
}

// =============================================================================
// MILESTONE 9 — Evidence Corroboration Engine
// =============================================================================

model Corroboration {
  id              String   @id @default(cuid())
  evidenceId      String
  userId          String
  type            String
  strength        Float    @default(0.5)
  reason          String?
  isIndependent   Boolean  @default(false)
  corroboratingEvidenceId String?
  metadata        String?
  createdAt       DateTime @default(now())

  evidence        Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, userId, type])
  @@index([evidenceId])
  @@index([userId])
  @@index([type])
}

model DuplicateGroup {
  id              String   @id @default(cuid())
  evidenceIds     String
  detectionMethod String
  confidence      Float    @default(0.5)
  metadata        String?
  status          String   @default("detected")
  createdAt       DateTime @default(now())

  @@index([detectionMethod])
  @@index([status])
}

model EvidenceWeight {
  id              String   @id @default(cuid())
  evidenceId      String   @unique
  weight          Float    @default(0.5)
  evidence        Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  confidence      Float    @default(0.5)
  factors         String?
  supportCount    Int      @default(0)
  disputeCount    Int      @default(0)
  independentCount Int     @default(0)
  tier            String   @default("unverified")
  lastCalculatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([weight])
  @@index([tier])
  @@index([confidence])
}

// =============================================================================
// MILESTONE 10 — Civil Trust Engine
