model TrustFactor {
  id              String   @id @default(cuid())
  userId          String   @unique
  accuracy        Float    @default(0.5)
  reliability     Float    @default(0.5)
  falseReportRate Float    @default(0.0)
  falseReportCount Int     @default(0)
  evidenceQuality Float    @default(0.5)
  contributionQuality Float @default(0.5)
  communityImpact Float    @default(0.0)
  fraudResistance Float    @default(1.0)
  fraudFlagCount  Int      @default(0)
  totalReports    Int      @default(0)
  verifiedReports Int      @default(0)
  totalEvidence   Int      @default(0)
  totalComments   Int      @default(0)
  totalShares     Int      @default(0)
  lastActivityAt  DateTime?
  decayRate       Float    @default(0.0)
  lastDecayAt     DateTime?
  compositeScore  Float    @default(0.0)
  tier            String   @default("unverified")
  factors         String?
  lastCalculatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([compositeScore])
  @@index([tier])
  @@index([accuracy])
}

model TrustDecayLog {
  id              String   @id @default(cuid())
  userId          String
  previousScore   Float
  newScore        Float
  decayAmount     Float
