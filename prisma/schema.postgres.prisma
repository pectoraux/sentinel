  minResolutionM  Float    @default(10)
  bands           String?
  isActive        Boolean  @default(true)
  createdById     String?
  lastSceneId     String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lastScene       SatelliteScene? @relation(fields: [lastSceneId], references: [id], onDelete: SetNull)

  @@index([satellite])
  @@index([isActive])
  @@index([nextRunAt])
}

model TileCacheStats {
