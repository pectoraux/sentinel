// =============================================================================
// MILESTONE 23 — Simulation Engine ("What if…?")
// =============================================================================
// Policy/operational simulation engine. Users pose "What if?" questions:
//   "What if we increase inspections by 50%?"
//   "What if we protect the Pra River watershed?"
//   "What if we close the access roads to Prestea?"
//   "What if we deploy drones over the Atewa Forest?"
//
// Each scenario combines 1+ interventions with parameters (intensity, duration,
// geographic scope). The engine predicts outcomes across 5 dimensions:
//   1. illegal_mining_rate  — % change in illegal mining activity
//   2. water_quality        — % change in water quality index
//   3. forest_cover         — hectares of forest saved/lost
//   4. economic_impact      — GHS economic impact (damages avoided + enforcement cost)
//   5. enforcement_cost     — GHS cost of implementing the intervention
//
// Scenarios can be compared side-by-side. Baseline scenarios track current
// trajectory without intervention.
// =============================================================================

model SimulationScenario {
  id              String   @id @default(cuid())
  key             String   @unique // e.g. "sim-prestea-inspections-001"
  name            String
  description     String
  // type: baseline | increase_inspections | protect_watershed | close_roads | deploy_drones | combined
  type            String
  // status: draft | running | completed | failed | archived
  status          String   @default("completed")
  // geographic scope
  region          String?
  district        String?
  locationName    String?
  lat             Float?
  lng             Float?
  radiusKm        Float?   // radius of the simulated area
  // time horizon
  timeHorizonMonths Int   @default(6) // 1, 3, 6, 12, 24 months
  // is this a baseline (no intervention)?
  isBaseline      Boolean  @default(false)
  // parameters JSON: { interventionType: { intensity, duration, frequency, ... } }
  parameters      String   // JSON
  // outcomes JSON: the predicted outcomes (5 dimensions × time series)
  outcomes        String?  // JSON
  // summary metrics (extracted from outcomes for quick display)
  illegalMiningRateChange Float @default(0) // % change (-100 to +100)
  waterQualityChange      Float @default(0) // % change (-100 to +100)
  forestCoverChangeHa     Float @default(0) // hectares (+ = saved, - = lost)
  economicImpactGHS       Float @default(0) // GHS (damages avoided - enforcement cost)
  enforcementCostGHS      Float @default(0) // GHS cost of intervention
  netBenefitGHS           Float @default(0) // economicImpact - enforcementCost
  // confidence: 0.0–1.0 — how confident the model is in the predictions
  confidence     Float    @default(0.7)
  // AI model
  model          String   @default("sim-engine-v1")
  algorithm      String   @default("intervention_impact_model")
  // input data references (what real data was used)
  inputInvestigationIds  String? // JSON array
  inputInspectionIds     String? // JSON array
  inputHotspotIds        String? // JSON array
  inputPredictionIds     String? // JSON array
  inputEntityIds         String? // JSON array
  // explanation
  explanation    String?  // human-readable explanation of the predicted outcomes
  factorsBreakdown String? // JSON: { factor: { value, weight, contribution } }
  // metadata
  metadata       String?  // JSON
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([region])
  @@index([isBaseline])
  @@index([createdAt])
  @@index([netBenefitGHS])
}

model SimulationComparison {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  description     String?
  // scenarios being compared (JSON array of scenario IDs)
  scenarioIds     String   // JSON array
  // comparison results
  results         String?  // JSON: { metric: { scenarioId: value } }
  // best scenario (highest net benefit)
  bestScenarioId  String?
  bestMetric      String?  // which metric determined the best (net_benefit | illegal_mining_reduction | water_quality_improvement)
  // metadata
  createdBy       String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

// =============================================================================
// MILESTONE 24 — Analytics Platform
// =============================================================================
// Comprehensive analytics across 6 categories:
//   1. Hotspots         — illegal mining hotspot trends, probability, risk levels
//   2. Environmental KPIs — water quality, forest cover, sediment, protected areas
//   3. Response Times    — investigation SLA, inspection turnaround, case resolution
//   4. Community Engagement — reports, evidence, comments, subscriptions, shares
//   5. Trust Metrics     — trust tiers, accuracy, reliability, fraud resistance
//   6. Reward Metrics    — pools, contributions, distributions, ROI
//
// KPIs are computed live from real platform data. Snapshots are stored
// periodically for trend analysis (comparing current vs. previous period).
// =============================================================================

model AnalyticsSnapshot {
  id              String   @id @default(cuid())
  // category: hotspots | environmental | response_times | community | trust | rewards
  category        String
  // period: daily | weekly | monthly
  period          String   @default("daily")
  // snapshot date (truncated to period start)
  snapshotDate    DateTime
  // KPIs JSON: { kpi_name: value }
  kpis            String   // JSON
  // summary metrics for quick display
  metricCount     Int      @default(0)
  // metadata
  computedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([category, period, snapshotDate])
  @@index([category])
  @@index([period])
  @@index([snapshotDate])
  @@index([computedAt])
}

// =============================================================================
// MILESTONE 25 — Developer Platform
// =============================================================================
// Exposes the Sentinel platform to third-party developers via:
//   1. REST API       — versioned, documented, API-key authenticated
//   2. GraphQL        — flexible query language for the Digital Twin
//   3. Webhooks       — event-driven push notifications (evidence, alerts, cases)
//   4. SDK            — official SDKs for JavaScript, Python, Go
//   5. Documentation  — interactive API docs, tutorials, code examples
//   6. Integrations   — third-party platform integrations (Slack, Teams, ArcGIS)
// =============================================================================

model WebhookEndpoint {
  id              String   @id @default(cuid())
  key             String   @unique
  // owner
  userId          String?
  organizationId  String?
  name            String
  description     String?
  url             String   // HTTPS endpoint URL
  // events: JSON array of event types the webhook is subscribed to
  events          String   // JSON: ["evidence.created", "alert.detected", ...]
  // auth
  secret          String?  // HMAC signing secret
  isActive        Boolean  @default(true)
  // delivery config
  maxRetries      Int      @default(3)
  retryDelaySec   Int      @default(60)
  timeoutSec      Int      @default(30)
  // stats
  deliveryCount   Int      @default(0)
  successCount    Int      @default(0)
  failureCount    Int      @default(0)
  lastDeliveryAt  DateTime?
  lastDeliveryStatus String? // success | failed | pending
  // metadata
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deliveries      WebhookDelivery[]

  @@index([userId])
  @@index([organizationId])
  @@index([isActive])
  @@index([createdAt])
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  endpointId      String
  // event details
  eventType       String   // e.g. "evidence.created"
  eventId         String   // unique event ID for idempotency
  payload         String   // JSON payload sent
  // delivery
  attempt         Int      @default(1) // 1, 2, 3...
  status          String   @default("pending") // pending | success | failed | retrying
  statusCode      Int?     // HTTP status code received
  responseTimeMs  Int?     // response time in ms
  responseBody    String?  // truncated response body
  errorMessage    String?
  // timing
  scheduledAt     DateTime @default(now())
  deliveredAt     DateTime?
  nextRetryAt     DateTime?
  createdAt       DateTime @default(now())

  endpoint        WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([eventType])
  @@index([status])
  @@index([scheduledAt])
}

model ApiKey {
  id              String   @id @default(cuid())
  key             String   @unique // the actual API key (prefixed "sk_live_" or "sk_test_")
  keyPrefix       String   // first 12 chars for display (sk_live_abc1...)
  name            String
  description     String?
  // owner
  userId          String?
  organizationId  String?
  // scopes: JSON array of permission scopes
  scopes          String   // JSON: ["read:evidence", "write:webhooks", ...]
