// =============================================================================
// Sentinel — Prisma Schema (Development: SQLite)
// =============================================================================
// This schema runs on SQLite for the local sandbox so the platform boots
// without a database server. It is structurally identical to the production
// PostgreSQL schema (see schema.postgres.prisma).
//
// PostGIS geometry columns are intentionally NOT modeled in Prisma (Prisma has
// no native geometry type). In production they are managed via raw SQL
// migrations (see prisma/sql/postgis.sql) and accessed through repository
// raw queries. This keeps the ORM models portable across both databases.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // Generated types include a shared `SentinelPrismaClient` augmentation.
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// IAM — Identity & Access Management
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String? // null for OAuth-only accounts
  status        String    @default("active") // active | suspended | locked | pending
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  userRoles     UserRole[]
  auditLogs     AuditLog[]
  createdFlags  FeatureFlag[]  @relation("FlagCreatedBy")
  updatedFlags  FeatureFlag[]  @relation("FlagUpdatedBy")
  orgMemberships OrganizationMember[]
  orgVerifiedBy  Organization[]  @relation("OrgVerifiedBy")
  devices        Device[]
  verifications  IdentityVerification[]
  trustProfile   TrustProfile?
  trustEvents    TrustEvent[]
  roleSwitches   RoleSwitchLog[]
  activeRole     ActiveRole?
  invitedOrgs    OrganizationInvitation[]  @relation("InvitedBy")

  @@index([status])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String // oauth | oidc | credentials
  provider          String // google | github | azure-ad | credentials
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// RBAC — Role-Based Access Control
// =============================================================================

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "admin", "analyst", "field-agent", "citizen-reporter"
  name        String
  description String?
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@index([key])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "cases:read", "reports:create"
  name        String
  description String?
  resource    String // e.g. "cases", "reports", "users"
  action      String // e.g. "read", "create", "update", "delete", "approve"
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  assignedAt DateTime @default(now())
  assignedBy String?
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// =============================================================================
// Audit Log (append-only, tamper-evident)
// =============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  actorId     String?  // user id (null for system events)
  actorType   String   @default("user") // user | system | service
  action      String   // e.g. "user.login", "feature_flag.updated"
  resource    String   // target resource type
  resourceId  String?  // target resource id
  outcome     String   @default("success") // success | failure | denied
  ipAddress   String?
  userAgent   String?
  requestId   String?  // correlation id for distributed tracing
  metadata    String?  // JSON string (portable across sqlite/postgres)
  hash        String?  // chaining hash for tamper-evidence
  prevHash    String?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([actorId])
  @@index([action])
  @@index([resource, resourceId])
}

// =============================================================================
// Feature Flags
// =============================================================================

model FeatureFlag {
  id          String    @id @default(cuid())
  key         String    @unique // e.g. "intelligence.engine.v2"
  name        String
  description String?
  enabled     Boolean   @default(false)
  // rollout: percentage of eligible users (0-100). 100 = all.
  rolloutPercentage Int @default(0)
  // strategy: boolean | percentage | segment | environment
  strategy    String    @default("boolean")
  // config: JSON string of strategy-specific config (segments, envs, etc.)
  config      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("FlagCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("FlagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  segments  FeatureFlagSegment[]

  @@index([enabled])
  @@index([key])
}

model FeatureFlagSegment {
  id           String  @id @default(cuid())
  flagId       String
  name         String
  // rule: JSON string describing the segment predicate
  rule         String
  priority     Int     @default(0)

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId])
}

// =============================================================================
// Event-Driven Architecture — Transactional Outbox
// =============================================================================
// Domain events are written to the outbox in the same DB transaction as the
// state change that produced them, then a background relay publishes them to
// the event bus. This guarantees at-least-once delivery without 2PC.
// =============================================================================

model OutboxEvent {
  id            String   @id @default(cuid())
  aggregateType String   // e.g. "User", "FeatureFlag"
  aggregateId   String
  eventType     String   // e.g. "user.created"
  payload       String   // JSON string
  metadata      String?  // JSON string (traceId, userId, etc.)
  occurredAt    DateTime @default(now())
  // status: pending | published | failed | dead_letter
  status        String   @default("pending")
  attempts      Int      @default(0)
  lastError     String?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([status, occurredAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType])
}

// =============================================================================
// Background Jobs — durable record
// =============================================================================

model JobRecord {
  id         String    @id @default(cuid())
  queue      String    // e.g. "default", "ingest", "notifications"
  name       String    // job handler name
  payload    String    // JSON string
  // status: queued | running | completed | failed | retrying | dead_letter
  status     String    @default("queued")
  attempts   Int       @default(0)
  maxAttempts Int      @default(3)
  lastError  String?
  scheduledAt DateTime @default(now())
  startedAt  DateTime?
  completedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([queue])
  @@index([name])
}

// =============================================================================
// Object Storage — metadata for stored objects
// =============================================================================

model StoredObject {
  id          String   @id @default(cuid())
  key         String   @unique // storage key (path)
  bucket      String   @default("default")
  provider    String   // local | s3 | minio
  contentType String?
  size        Int      @default(0)
  checksum    String?  // sha256
  // ownerType/ownerId: e.g. ("Report", "abc123")
  ownerType   String?
  ownerId     String?
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bucket, key])
  @@index([ownerType, ownerId])
}

// =============================================================================
// Health Checks — recent snapshots
// =============================================================================

model HealthCheckResult {
  id          String   @id @default(cuid())
  checkName   String   // e.g. "database", "storage", "event-bus"
  status      String   // healthy | degraded | unhealthy
  latencyMs   Int
  message     String?
  checkedAt   DateTime @default(now())

  @@index([checkName, checkedAt])
}

// =============================================================================
// MILESTONE 2 — Identity & Trust Platform
// =============================================================================
// Organizations (Government Agencies, NGOs, Researchers), members, invitations,
// device management, identity verification, trust profiles, role switching,
// active session management. All designed to extend M1 foundations.
// =============================================================================

model Organization {
  id          String   @id @default(cuid())
  key         String   @unique // slug, e.g. "galamsey-task-force"
  name        String
  type        String   // government_agency | ngo | researcher | regulator | community
  country     String?  // ISO country code e.g. "GH"
  region      String?
  description String?
  logoUrl     String?
  // status: active | suspended | dissolved | pending_verification
  status      String   @default("pending_verification")
  verifiedAt  DateTime?
  verifiedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  verifier    User? @relation("OrgVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  devices     Device[]
  verifications IdentityVerification[]

  @@index([type])
  @@index([status])
  @@index([country])
}

model OrganizationMember {
  id            String   @id @default(cuid())
  organizationId String
  userId        String
  // role within the org: owner | admin | member | inspector | moderator | observer
  role          String   @default("member")
  // the org role that becomes "active" when the user switches into this org context
  joinedAt      DateTime @default(now())
  invitedBy     String?
  status        String   @default("active") // active | revoked | pending
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model OrganizationInvitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String   @default("member")
  token          String   @unique
  invitedById    String
  // status: pending | accepted | declined | expired | revoked
  status         String   @default("pending")
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User          @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status])
}

model Device {
  id            String   @id @default(cuid())
  userId        String
  organizationId String?
  fingerprint   String   @unique // stable device fingerprint (UA + screen + tz hash)
  label         String?  // user-provided name e.g. "MacBook Pro"
  platform      String?  // ios | android | macos | windows | linux | web
  userAgent     String?
  // status: trusted | active | unverified | revoked | lost
  status        String   @default("unverified")
  lastSeenAt    DateTime @default(now())
  lastSeenIp    String?
  location      String?  // coarse geo: city, country
  trustedAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

model IdentityVerification {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String?
  // type: government_id | passport | phone_otp | email | address | biometric | organization_docs
  type            String
  // status: pending | under_review | approved | rejected | expired
  status          String   @default("pending")
  // documentReference: storage key of the uploaded evidence (StoredObject.key)
  documentReference String?
  // submitted data payload (JSON): document number (redacted), country, etc.
  submittedData   String?
  // reviewer notes / rejection reason
  reviewerNotes   String?
  reviewedById    String?
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([type])
}

model TrustProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  // 0-100 trust score; computed from verifications, activity, reports, disputes
  score           Int      @default(0)
  tier            String   @default("unverified") // unverified | basic | verified | trusted | elite
  // contributing factors (JSON): { verifications: n, reportsSubmitted: n, reportsVerified: n, disputes: n }
  factors         String?
  // badges (JSON array): ["id_verified", "org_member", "top_reporter", "early_adopter"]
  badges          String?
  lastRecalculatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([score])
  @@index([tier])
}

model TrustEvent {
  id          String   @id @default(cuid())
  userId      String
  // type: verification_approved | report_verified | report_rejected | dispute_filed | org_joined | badge_earned | penalty
  type        String
  delta       Int      // score change (+5, -10)
  reason      String?
  metadata    String?  // JSON
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model RoleSwitchLog {
  id          String   @id @default(cuid())
  userId      String
  // fromRole / toRole: the RBAC role key the user switched between
  fromRole    String?
  toRole      String
  // contextType: global | organization ; contextId: org id if organization
  contextType String   @default("global")
  contextId   String?
  reason      String?
  ip          String?
  switchedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([switchedAt])
}

// Track the user's currently-active role context (for role switching).
// Stored separately so the user can have multiple sessions with different
// active roles without affecting other sessions.
model ActiveRole {
  id          String   @id @default(cuid())
  userId      String   @unique
  roleKey     String   // current active RBAC role
  contextType String   @default("global") // global | organization
  contextId   String?  // organization id when contextType=organization
  setAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================================================================
// MILESTONE 3 — Geospatial Platform (GIS Engine)
// =============================================================================
// PointOfInterest, SpatialRegion (polygons), GeoLayer (map layers).
//
// On SQLite (dev): lat/lng stored as Float, geojson as String (JSON).
// On PostgreSQL+PostGIS (prod): numeric columns + native geography(Point/Polygon)
// columns added via prisma/sql/postgis.sql (Prisma has no native geometry type).
// The SpatialQueryService abstracts both: dev uses Haversine + ray-casting in
// TypeScript; prod delegates to ST_DWithin / ST_Contains / ST_Distance.
// =============================================================================

model PointOfInterest {
  id          String   @id @default(cuid())
  name        String
  type        String   // mining_site | water_body | forest_reserve | settlement | sensor_station | incident | checkpoint
  lat         Float
  lng         Float
  // geojson: full GeoJSON Feature as JSON string (includes properties, geometry)
  geojson     String?
  layerId     String?
  country     String?  // ISO code e.g. "GH"
  region      String?
  status      String   @default("active") // active | monitored | closed | verified | false_positive
  severity    String?  // low | medium | high | critical (for incidents)
  metadata    String?  // JSON: { confidence, source, reportCount, ... }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  layer       GeoLayer? @relation(fields: [layerId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([country])
  @@index([layerId])
  // Composite index for bounding-box queries (lng range then lat range)
  @@index([lng, lat])
}

model SpatialRegion {
  id          String   @id @default(cuid())
  name        String
  type        String   // protected_area | forest_reserve | water_body | mining_concession | administrative_boundary | hot_zone
  // geojson: GeoJSON Polygon/MultiPolygon as JSON string
  // For dev (SQLite), the polygon coordinates are in geojson. For prod, a
  // geography(Polygon,4326) column is also added via postgis.sql.
  geojson     String
  // bbox: [minLng, minLat, maxLng, maxLat] as JSON for fast pre-filtering
  bbox        String?
  areaKm2     Float?
  country     String?
  region      String?
  layerId     String?
  status      String   @default("active")
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  layer       GeoLayer? @relation(fields: [layerId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([country])
  @@index([layerId])
}

model GeoLayer {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "osm-base", "satellite", "mining-sites", "forest-reserves"
  name        String
  type        String   // base | overlay | data | vector
  source      String   // osm | sentinel | landsat | custom | internal
  description String?
  visible     Boolean  @default(true)
  zIndex      Int      @default(0)
  opacity     Float    @default(1.0)
  // config: JSON — tile URL template, style params, etc.
  // e.g. { "tileUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png", "maxZoom": 19 }
  config      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  points      PointOfInterest[]
  regions     SpatialRegion[]

  @@index([type])
  @@index([visible])
}

model GeoTileManifest {
  id          String   @id @default(cuid())
  layerId     String
  z           Int      // zoom level
  x           Int      // tile column
  y           Int      // tile row (XYZ scheme)
  // status: cached | stale | pending | unavailable
  status      String   @default("pending")
  etag        String?
  sizeBytes   Int      @default(0)
  cachedAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@unique([layerId, z, x, y])
  @@index([layerId, z])
  @@index([status])
}

// =============================================================================
// MILESTONE 4 — Digital Twin Core
// =============================================================================
// Every environmental object becomes a versioned, related, historical entity.
// Rather than 11 rigid tables, we use a UNIFIED TwinEntity model with a type
// discriminator — this is the canonical Digital Twin architecture:
//
//   TwinEntity          — the live object (River, Road, Mine, Forest, ...)
//   TwinEntityVersion   — immutable versioned snapshots (full audit trail)
//   TwinRelationship    — graph edges between entities (near, contains, affects)
//   TwinEvent           — timeline of events/state changes per entity
//
// Entity types: river, road, mine, forest, community, inspection, event,
// concession, protected_area, equipment, historical_imagery
// =============================================================================

model TwinEntity {
  id              String   @id @default(cuid())
  key             String   @unique // human-readable unique key, e.g. "river-pra-main"
  type            String   // river | road | mine | forest | community | inspection | event | concession | protected_area | equipment | historical_imagery
  name            String
  description     String?
  status          String   @default("active") // active | monitored | closed | degraded | historical | planned
  // geojson: optional GeoJSON geometry (Point, LineString, or Polygon)
  geojson         String?
  lat             Float?
  lng             Float?
  // metadata: flexible JSON — type-specific attributes (flow_rate for rivers,
  // capacity for mines, population for communities, capture_date for imagery, etc.)
  metadata        String?
  // currentVersion: monotonically increasing version number
  currentVersion  Int      @default(1)
  // organizationId: optional owning org (for concessions, equipment, etc.)
  organizationId  String?
  country         String?
  region          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions        TwinEntityVersion[]
  events          TwinEvent[]
  // Relationships — both outgoing (this → other) and incoming (other → this)
  relationshipsFrom TwinRelationship[] @relation("RelFrom")
  relationshipsTo   TwinRelationship[] @relation("RelTo")

  @@index([type])
  @@index([status])
  @@index([country])
  @@index([organizationId])
  @@index([lng, lat])
}

model TwinEntityVersion {
  id              String   @id @default(cuid())
  entityId        String
  version         Int      // version number (1, 2, 3, ...)
  // snapshot: full JSON snapshot of the entity state at this version
  snapshot        String
  // changeReason: why this version was created (human-readable)
  changeReason    String?
  // diff: JSON describing what changed from the previous version
  diff            String?
  changedById     String?
  validFrom       DateTime @default(now())
  validTo         DateTime?
  createdAt       DateTime @default(now())

  entity TwinEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, version])
  @@index([entityId])
  @@index([validFrom])
}

model TwinRelationship {
  id              String   @id @default(cuid())
  fromEntityId    String
  toEntityId      String
  // type: near | contains | within | connects_to | affects | monitors | supplies | borders | upstream | downstream | depends_on | threatens
  type            String
  // strength: 0.0–1.0 for weighted relationships (e.g. proximity strength)
  strength        Float    @default(1.0)
  // metadata: JSON — relationship-specific data (distance_m, flow_direction, etc.)
  metadata        String?
  // bidirectional: if true, the relationship is symmetric (A↔B)
  bidirectional   Boolean  @default(false)
  validFrom       DateTime @default(now())
  validTo         DateTime?
  createdAt       DateTime @default(now())

  fromEntity TwinEntity @relation("RelFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   TwinEntity @relation("RelTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, type])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([type])
}

model TwinEvent {
  id              String   @id @default(cuid())
  entityId        String
  // type: created | updated | status_changed | inspected | incident | restored | depleted | expanded | reported | verified
  type            String
  title           String
  description     String?
  // severity: info | low | medium | high | critical
  severity        String   @default("info")
  // payload: JSON — event-specific data
  payload         String?
  // source: who/what triggered the event (user id, system, sensor, satellite)
  source          String?
  sourceType      String   @default("system") // user | system | sensor | satellite | report
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now())

  entity TwinEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([type])
  @@index([severity])
  @@index([timestamp])
}

// =============================================================================
// MILESTONE 7 — Evidence Platform
// =============================================================================
// Universal evidence service supporting images, video, audio, documents, GPS
// tracks, and arbitrary metadata. Every evidence item is:
//   - Hashed (SHA-256 content fingerprint)
//   - Hash-chained (each version references the previous hash → tamper-evident)
//   - Optionally encrypted (at-rest encryption key stored separately)
//   - Versioned (immutable version snapshots, same temporal model as Twin)
//   - GPS-tagged (lat/lng + optional GeoJSON track)
//   - Metadata-rich (flexible JSON for type-specific attributes)
// =============================================================================

model Evidence {
  id              String   @id @default(cuid())
  key             String   @unique // human-readable key, e.g. "evd-prestea-cyanide-001"
  title           String
  description     String?
  // type: image | video | audio | document | gps_track | sensor_log | report | other
  type            String
  // mediaType: MIME type (image/jpeg, video/mp4, audio/mpeg, application/pdf, ...)
  mediaType       String
  // storageKey: object storage key (StoredObject.key or external URL)
  storageKey      String
  storageProvider String   @default("local")
  // sizeBytes: file size
  sizeBytes       Int      @default(0)
  // checksum: SHA-256 hash of the original content (content fingerprint)
  checksum        String
  // currentHash: hash of the current version's content + metadata (hash chain head)
  currentHash     String
  // previousHash: hash of the previous version (hash chain link)
  previousHash    String?
  // encryption: encryption status + key reference
  encrypted       Boolean  @default(false)
  encryptionKeyId String?  // reference to key in the secrets manager (never store the key itself)
  // GPS: capture location
  lat             Float?
  lng             Float?
  // geojson: optional GeoJSON track (for GPS tracks) or area
  geojson         String?
  // metadata: flexible JSON (exif, duration, resolution, deviceInfo, etc.)
  metadata        String?
  // currentVersion: monotonically increasing version number
  currentVersion  Int      @default(1)
  // ownership + provenance
  uploadedById    String?
  organizationId  String?
  // twinEntityId: optional link to a Digital Twin entity (e.g. inspection evidence)
  twinEntityId    String?
  // verification status
  verified        Boolean  @default(false)
  verifiedById    String?
  verifiedAt      DateTime?
  // chain integrity
  chainValid      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions        EvidenceVersion[]
  weight          EvidenceWeight?
  corroborations  Corroboration[]

  @@index([type])
  @@index([mediaType])
  @@index([uploadedById])
  @@index([organizationId])
  @@index([twinEntityId])
  @@index([verified])
  @@index([lat, lng])
}

model EvidenceVersion {
  id              String   @id @default(cuid())
  evidenceId      String
  version         Int
  // snapshot: full JSON snapshot of the evidence state at this version
  snapshot        String
  // contentHash: SHA-256 of the content at this version
  contentHash     String
  // metadataHash: SHA-256 of the metadata at this version
  metadataHash    String
  // combinedHash: SHA-256(contentHash + metadataHash + previousHash) — the chain link
  combinedHash    String
  // previousHash: combinedHash of the previous version
  previousHash    String?
  // changeReason: why this version was created
  changeReason    String?
  // diff: JSON describing what changed
  diff            String?
  // storageKey: content storage key at this version (may differ if re-uploaded)
  storageKey      String
  sizeBytes       Int
  changedById     String?
  validFrom       DateTime @default(now())
  validTo         DateTime?
  createdAt       DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, version])
  @@index([evidenceId])
  @@index([validFrom])
}

// =============================================================================
// MILESTONE 8 — Community Intelligence (Event-Sourced)
// =============================================================================
// Users create Intelligence Events, upload evidence, subscribe, comment, watch,
// share, and follow. EVERYTHING is event-sourced: each action appends an
// immutable event to the IntelligenceEventStream. The current state is a
// projection (fold) over the event stream — nothing is mutated in place.
//
// Models:
//   IntelligenceEvent   — the aggregate root (projection of the event stream)
//   EventStreamEntry    — immutable append-only event log (the source of truth)
//   EventComment        — comments on an event
//   EventSubscription   — watch/follow subscriptions
//   EventShare          — share records
//   EventProjection     — cached read model (rebuildable from the stream)
// =============================================================================

model IntelligenceEvent {
  id              String   @id @default(cuid())
  key             String   @unique // human-readable key
  title           String
  description     String?
  // type: pollution | deforestation | illegal_mining | water_contamination | land_degradation | wildlife_crime | other
  type            String
  status          String   @default("open") // open | investigating | verified | resolved | false_positive
  severity        String   @default("medium") // low | medium | high | critical
  // location
  lat             Float?
  lng             Float?
  locationName    String?
  // ownership
  createdById     String
  organizationId  String?
  twinEntityId    String?
  // linked evidence
  evidenceIds     String?  // JSON array of Evidence IDs
  // projection counters (derived from event stream)
  commentCount    Int      @default(0)
  subscriberCount Int      @default(0)
  watcherCount    Int      @default(0)
  shareCount      Int      @default(0)
  viewCount       Int      @default(0)
  // stream version (optimistic concurrency)
  streamVersion   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stream          EventStreamEntry[]
  comments        EventComment[]
  subscriptions   EventSubscription[]
  shares          EventShare[]

  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([createdById])
  @@index([organizationId])
  @@index([lat, lng])
  @@index([createdAt])
}

// The append-only event log — the source of truth. Every action (create,
// comment, subscribe, share, status change, evidence attach) appends here.
model EventStreamEntry {
  id              String   @id @default(cuid())
  eventId         String
  version         Int      // monotonically increasing per event
  // eventType: created | commented | subscribed | unsubscribed | watched | shared | viewed | status_changed | evidence_attached | severity_changed | description_updated
  eventType       String
  actorId         String?
  actorType       String   @default("user") // user | system | sensor | satellite
  // payload: JSON — event-specific data (comment text, subscriber userId, etc.)
  payload         String?
  metadata        String?  // JSON — traceId, ip, userAgent
  timestamp       DateTime @default(now())

  event IntelligenceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, version])
  @@index([eventId])
  @@index([eventType])
  @@index([timestamp])
  @@index([actorId])
}

model EventComment {
  id              String   @id @default(cuid())
  eventId         String
  authorId        String
  body            String
  // parentId: null for top-level, or ID of parent comment for threaded replies
  parentId        String?
  // attachments: JSON array of evidence IDs referenced in the comment
  attachments     String?
  edited          Boolean  @default(false)
  editedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event IntelligenceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([authorId])
  @@index([parentId])
}

model EventSubscription {
  id              String   @id @default(cuid())
  eventId         String
  userId          String
  // type: watch (get notifications) | follow (track in feed) | mute (suppress)
  type            String   @default("watch")
  createdAt       DateTime @default(now())

  event IntelligenceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, type])
  @@index([eventId])
  @@index([userId])
}

model EventShare {
  id              String   @id @default(cuid())
  eventId         String
  sharedById      String
  // platform: internal | email | twitter | whatsapp | telegram | link
  platform        String   @default("internal")
  recipientId     String?  // for internal shares
  message         String?
  createdAt       DateTime @default(now())

  event IntelligenceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([sharedById])
}

// =============================================================================
// MILESTONE 9 — Evidence Corroboration Engine
// =============================================================================
// Instead of simple up/down votes, evidence is assessed through:
//   - Support (corroboration by another user/source)
//   - Dispute (challenge by another user/source)
//   - Independent corroboration (multiple independent sources confirm)
//   - Duplicate detection (same content hash, location, or time proximity)
//   - Witness confidence (weighted by trust tier + corroboration count)
//   - Evidence weighting (reliability score from all factors)
// =============================================================================

model Corroboration {
  id              String   @id @default(cuid())
  evidenceId      String
  userId          String
  // type: support | dispute
  type            String
  // strength: 0.0–1.0 — how strongly the user supports/disputes (based on trust tier)
  strength        Float    @default(0.5)
  // reason: why the user supports/disputes
  reason          String?
  // isIndependent: true if this corroboration is from an independent source
  // (different organization, different device, no relationship to original submitter)
  isIndependent   Boolean  @default(false)
  // corroborationEvidenceId: optional link to corroborating evidence the user uploaded
  corroboratingEvidenceId String?
  metadata        String?  // JSON
  createdAt       DateTime @default(now())

  evidence        Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, userId, type])
  @@index([evidenceId])
  @@index([userId])
  @@index([type])
}

model DuplicateGroup {
  id              String   @id @default(cuid())
  // evidenceIds: JSON array of evidence IDs that are duplicates of each other
  evidenceIds     String
  // detectionMethod: hash_match | location_proximity | time_proximity | content_similarity
  detectionMethod String
  // confidence: 0.0–1.0 — how confident the duplicate detection is
  confidence      Float    @default(0.5)
  // metadata: JSON — detection details (distance_m, time_diff_sec, hash_prefix, etc.)
  metadata        String?
  status          String   @default("detected") // detected | confirmed | dismissed
  createdAt       DateTime @default(now())

  @@index([detectionMethod])
  @@index([status])
}

model EvidenceWeight {
  id              String   @id @default(cuid())
  evidenceId      String   @unique
  // weight: 0.0–1.0 — the overall reliability weight of this evidence
  weight          Float    @default(0.5)
  evidence        Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  // confidence: 0.0–1.0 — witness confidence score
  confidence      Float    @default(0.5)
  // factors: JSON breakdown of how the weight was computed
  // { baseTrust, supportCount, disputeCount, independentCorroboration, duplicatePenalty, verificationBonus }
  factors         String?
  // supportCount / disputeCount: derived from Corroboration table
  supportCount    Int      @default(0)
  disputeCount    Int      @default(0)
  independentCount Int     @default(0)
  // tier: unverified | weak | moderate | strong | confirmed
  tier            String   @default("unverified")
  lastCalculatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([weight])
  @@index([tier])
  @@index([confidence])
}

// =============================================================================
// MILESTONE 10 — Civil Trust Engine
// =============================================================================
// Production trust system replacing simple reputation. Tracks 8 factors:
//   1. Accuracy       — verified reports / total reports
//   2. Reliability    — consistency over time (report frequency + verification rate)
//   3. False reports  — count of false-positive submissions (penalty)
//   4. Evidence quality — aggregate from M9 evidence weights
//   5. Contribution quality — comment/event quality (corroboration support rate)
//   6. Community impact  — positive impact (resolutions, helpful shares)
//   7. Decay          — trust decays if inactive (half-life 90 days)
//   8. Fraud resistance — fraud flags reduce trust; clean history boosts it
// =============================================================================

model TrustFactor {
  id              String   @id @default(cuid())
  userId          String   @unique
  // Core metrics (each 0.0–1.0 unless noted)
  accuracy        Float    @default(0.5)   // verified / total reports
  reliability     Float    @default(0.5)   // consistency score
  falseReportRate Float    @default(0.0)   // false reports / total reports
  falseReportCount Int     @default(0)
  evidenceQuality Float    @default(0.5)   // avg evidence weight (M9)
  contributionQuality Float @default(0.5)  // corroboration support rate
  communityImpact Float    @default(0.0)   // positive impact score
  fraudResistance Float    @default(1.0)   // 1.0 = clean, decreases per flag
  fraudFlagCount  Int      @default(0)
  // Activity metrics
  totalReports    Int      @default(0)
  verifiedReports Int      @default(0)
  totalEvidence   Int      @default(0)
  totalComments   Int      @default(0)
  totalShares     Int      @default(0)
  lastActivityAt  DateTime?
  // Decay tracking
  decayRate       Float    @default(0.0)   // current decay multiplier (0.0 = no decay, 1.0 = full)
  lastDecayAt     DateTime?
  // Computed composite
  compositeScore  Float    @default(0.0)   // final 0.0–1.0 trust score
  tier            String   @default("unverified") // unverified | basic | verified | trusted | elite
  factors         String?  // JSON breakdown of how composite was computed
  lastCalculatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([compositeScore])
  @@index([tier])
  @@index([accuracy])
}

model TrustDecayLog {
  id              String   @id @default(cuid())
  userId          String
  // previousScore / newScore after decay
  previousScore   Float
  newScore        Float
  decayAmount     Float
  // daysInactive: days since last activity
  daysInactive    Int
  // decayRate applied
  decayRate       Float
  appliedAt       DateTime @default(now())

  @@index([userId])
  @@index([appliedAt])
}

model FraudFlag {
  id              String   @id @default(cuid())
  userId          String
  // type: duplicate_spam | false_report | coordinated_manipulation | bot_behavior | identity_theft | other
  type            String
  // severity: low | medium | high | critical
  severity        String   @default("medium")
  description     String
  // evidence: JSON array of evidence/event IDs supporting the flag
  evidence        String?
  // status: detected | investigating | confirmed | dismissed | resolved
  status          String   @default("detected")
  detectedAt      DateTime @default(now())
  resolvedAt      DateTime?
  resolvedById    String?
  resolution      String?
  // penalty: trust score penalty applied (0.0–1.0)
  penalty         Float    @default(0.0)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([severity])
}

// =============================================================================
// MILESTONE 11 — Notification Platform
// =============================================================================
// Multi-channel notification system: Push, Email, SMS, In-app.
// Supports geofenced subscriptions, interest subscriptions, digest mode,
// and priority notifications.
// =============================================================================

model NotificationChannel {
  id              String   @id @default(cuid())
  userId          String
  // type: push | email | sms | in_app
  type            String
  // address: device token (push), email address, phone number, or null for in_app
  address         String?
  // isVerified: whether the channel has been verified (email/SMS confirmation)
  isVerified      Boolean  @default(false)
  // isEnabled: user can disable a channel without deleting it
  isEnabled       Boolean  @default(true)
  // preferences: JSON — per-channel preferences (quiet hours, min priority, etc.)
  preferences     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, type, address])
  @@index([userId])
  @@index([type])
}

model NotificationSubscription {
  id              String   @id @default(cuid())
  userId          String
  // subscriptionType: geofence | interest | event_type | entity
  subscriptionType String
  // target: for geofence = GeoJSON polygon JSON; for interest = topic key;
  //         for event_type = "intelligence.created" etc; for entity = entity ID
  target          String
  // channels: JSON array of channel types to notify via ["push","email","sms","in_app"]
  channels        String   @default("[\"in_app\"]")
  // minPriority: only notify for notifications >= this priority (0=low, 1=normal, 2=high, 3=critical)
  minPriority     Int      @default(0)
  // digestMode: none | hourly | daily | weekly
  digestMode      String   @default("none")
  // isActive
  isActive        Boolean  @default(true)
  // metadata: JSON — subscription-specific config (radius_m, topics, etc.)
  metadata        String?
  createdAt       DateTime @default(now())

  @@unique([userId, subscriptionType, target])
  @@index([userId])
  @@index([subscriptionType])
  @@index([isActive])
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  // type: intelligence_event | evidence_upload | trust_change | corroboration | system | alert | digest
  type            String
  title           String
  body            String
  // priority: 0=low, 1=normal, 2=high, 3=critical
  priority        Int      @default(1)
  // channels: JSON array of channels this was sent via
  channels        String   @default("[\"in_app\"]")
  // data: JSON — payload (eventId, evidenceId, link, etc.)
  data            String?
  // read status
  isRead          Boolean  @default(false)
  readAt          DateTime?
  // delivery status per channel: JSON [{ channel, status, deliveredAt, error }]
  deliveryStatus  String?
  // source: what triggered this notification
  source          String   @default("system") // system | event_bus | manual | digest
  // geofence match (if applicable)
  matchedGeofence String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([priority])
  @@index([isRead])
  @@index([createdAt])
}

model NotificationDigest {
  id              String   @id @default(cuid())
  userId          String
  // period: hourly | daily | weekly
  period          String
  // startTime / endTime: the time range this digest covers
  startTime       DateTime
  endTime         DateTime
  // notificationIds: JSON array of notification IDs included in this digest
  notificationIds String
  // count: number of notifications in this digest
  count           Int      @default(0)
  // status: pending | sent | failed
  status          String   @default("pending")
  sentAt          DateTime?
  // channels: JSON array of channels the digest was sent via
  channels        String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([period])
}

model GeofenceSubscription {
  id              String   @id @default(cuid())
  userId          String
  name            String
  // geojson: GeoJSON Polygon defining the geofence boundary
  geojson         String
  // centerLat / centerLng: centroid for quick distance checks
  centerLat       Float
  centerLng       Float
  // radiusM: radius in meters (for circular geofences, used with center)
  radiusM         Float?
  // channels: JSON array of channels
  channels        String   @default("[\"push\",\"in_app\"]")
  // minPriority: minimum priority to trigger
  minPriority     Int      @default(1)
  // eventTypes: JSON array of event types that trigger this geofence
  eventTypes      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([isActive])
  @@index([centerLat, centerLng])
}

// =============================================================================
// MILESTONE 12 — Satellite Ingestion
// =============================================================================
// Satellite imagery ingestion pipeline: Sentinel-2, Landsat-8.
// Raster processing → tiling → caching → historical archive.
// Scheduled acquisition with metadata tracking.
// =============================================================================

model SatelliteScene {
  id              String   @id @default(cuid())
  sceneId         String   @unique // official scene ID (e.g. "S2A_MSIL2A_20240715T103021_N0509_R108_T30NWN")
  satellite       String   // sentinel2 | landsat8 | sentinel1 | landsat9
  sensor          String   // MSI (Sentinel-2) | OLI_TIRS (Landsat-8)
  // acquisition
  acquisitionDate DateTime
  cloudCover      Float    @default(0) // percentage 0-100
  sunAzimuth      Float?
  sunElevation    Float?
  // spatial
  crs             String   @default("EPSG:4326")
  bbox            String   // JSON [minLng, minLat, maxLng, maxLat]
  centerLat       Float
  centerLng       Float
  // resolution
  resolutionM     Float    @default(10) // meters per pixel
  // processing
  // status: scheduled | downloading | processing | tiling | caching | ready | archived | failed
  status          String   @default("scheduled")
  processingStage String   @default("pending") // pending | downloaded | rectified | tiled | cached | archived
  // storage
  rawStorageKey   String?  // raw downloaded data storage key
  tiledStorageKey String?  // tiled data storage prefix
  thumbnailKey    String?
  sizeBytes       Int      @default(0)
  // metadata
  bands           String?  // JSON array of band info
  metadata        String?  // JSON — full scene metadata
  // scheduling
  scheduledById   String?
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tiles           RasterTile[]
  schedule        IngestionSchedule?

  @@index([satellite])
  @@index([status])
  @@index([acquisitionDate])
  @@index([centerLat, centerLng])
  @@index([cloudCover])
}

model RasterTile {
  id              String   @id @default(cuid())
  sceneId         String
  z               Int      // zoom level
  x               Int      // tile column (XYZ scheme)
  y               Int      // tile row (XYZ scheme)
  quadkey         String   // Bing quadkey for spatial indexing
  // storage
  storageKey      String   // object storage key
  sizeBytes       Int      @default(0)
  contentType     String   @default("image/png")
  // cache
  // cacheStatus: cached | stale | evicted | pending
  cacheStatus     String   @default("pending")
  cachedAt        DateTime?
  expiresAt       DateTime?
  accessCount     Int      @default(0)
  lastAccessedAt  DateTime?
  // tile metadata
  bands           String?  // JSON — which bands are in this tile
  checksum        String?  // SHA-256 for integrity
  createdAt       DateTime @default(now())

  scene           SatelliteScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([sceneId, z, x, y])
  @@index([sceneId, z])
  @@index([cacheStatus])
  @@index([quadkey])
  @@index([z, x, y])
}

model IngestionSchedule {
  id              String   @id @default(cuid())
  name            String
  satellite       String   // sentinel2 | landsat8
  // area of interest
  bbox            String   // JSON [minLng, minLat, maxLng, maxLat]
  centerLat       Float
  centerLng       Float
  // schedule
  // frequency: daily | weekly | monthly | manual
  frequency       String   @default("weekly")
  cronExpression  String?  // e.g. "0 6 * * 1" = every Monday 6AM
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  // filters
  maxCloudCover   Float    @default(20) // max cloud cover %
  minResolutionM  Float    @default(10)
  bands           String?  // JSON — requested bands
  // status
  isActive        Boolean  @default(true)
  createdById     String?
  // linked scene (last ingested)
  lastSceneId     String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lastScene       SatelliteScene? @relation(fields: [lastSceneId], references: [id], onDelete: SetNull)

  @@index([satellite])
  @@index([isActive])
  @@index([nextRunAt])
}

model TileCacheStats {
  id              String   @id @default(cuid())
  // aggregate cache statistics (updated periodically)
  totalTiles      Int      @default(0)
  cachedTiles     Int      @default(0)
  staleTiles      Int      @default(0)
  evictedTiles    Int      @default(0)
  totalCacheBytes Int      @default(0)
  hitRate         Float    @default(0) // 0.0-1.0
  missRate        Float    @default(0)
  // eviction policy
  maxCacheSizeGb  Float    @default(10) // max cache size in GB
  evictionPolicy  String   @default("lru") // lru | lfu | fifo
  lastEvictionAt  DateTime?
  computedAt      DateTime @default(now())

  @@index([computedAt])
}

// =============================================================================
// MILESTONE 13 — Computer Vision Platform
// =============================================================================
// Real AI detection using VLM (Vision Language Model) via z-ai-web-dev-sdk.
// Detects: excavation, roads, tailings, forest_loss, water_changes, buildings, equipment.
// =============================================================================

model DetectionResult {
  id              String   @id @default(cuid())
  // source: the image/scene that was analyzed
  sceneId         String?  // link to SatelliteScene (optional)
  evidenceId      String?  // link to Evidence (optional)
  imageUrl        String   // URL or data URI of the analyzed image
  // detection type
  type            String   // excavation | roads | tailings | forest_loss | water_changes | buildings | equipment
  // AI result
  detected        Boolean  // whether the feature was detected
  confidence      Float    @default(0) // 0.0-1.0
  // structured output from VLM
  description     String?  // AI-generated description of what was detected
  boundingBoxes   String?  // JSON array of {x, y, width, height, label, confidence}
  severity        String?  // low | medium | high | critical (for environmental damage assessment)
  area            String?  // JSON: { areaHectares, percentage }
  // model metadata
  model           String   @default("vlm-zai") // which model performed the detection
  prompt          String?  // the prompt used
  processingMs    Int      @default(0) // processing time in ms
  // raw VLM response (for audit)
  rawResponse     String?  // full VLM response text
  // status
  status          String   @default("completed") // pending | processing | completed | failed
  error           String?
  // user/system
  triggeredBy     String?  // user ID or "system" / "schedule"
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([detected])
  @@index([confidence])
  @@index([sceneId])
  @@index([evidenceId])
  @@index([createdAt])
}

model DetectionBatch {
  id              String   @id @default(cuid())
  name            String
  // batchType: scene_analysis | evidence_analysis | change_detection | scheduled
  batchType       String   @default("scene_analysis")
  // targets: JSON array of image URLs or scene IDs
  targets         String
  // detection types to run
  detectionTypes  String   // JSON array
  // results
  resultCount     Int      @default(0)
  detectedCount   Int      @default(0)
  // status: pending | processing | completed | failed
  status          String   @default("pending")
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?
  triggeredBy     String?
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([batchType])
}

// =============================================================================
// MILESTONE 14 — AI Observation Engine
// =============================================================================
// AI creates Intelligence Events from CV detection results. Each observation
// stores: evidence (linked detection results), confidence, reasoning (AI-generated
// explanation), affected entities (twin entities impacted), and historical
// comparison (comparison with past observations of the same area/type).
// =============================================================================

model AIObservation {
  id              String   @id @default(cuid())
  // source: the CV detection that triggered this observation
  detectionResultId String?
  // linked intelligence event (created by this observation)
  intelligenceEventId String?
  // observation metadata
  title           String
  summary         String   // AI-generated one-line summary
  // type: matches the detection type (excavation, forest_loss, etc.)
  type            String
  severity        String   // low | medium | high | critical
  confidence      Float    // 0.0-1.0 (from detection, may be adjusted)
  // AI reasoning — the full chain of thought explaining why this observation was made
  reasoning       String   // structured reasoning text
  reasoningSteps  String?  // JSON array of reasoning steps
  // evidence — linked detection results supporting this observation
  evidenceIds     String?  // JSON array of detection result IDs
  evidenceSummary String?  // summary of supporting evidence
  // affected entities — twin entities impacted by this observation
  affectedEntityIds String? // JSON array of twin entity IDs
  affectedEntitiesSummary String? // human-readable summary of affected entities
  // historical comparison — comparison with past observations
  historicalComparison String? // JSON: { previousObservations: [...], trend: "increasing|decreasing|stable|new", changePercent: number }
  // metadata
  model           String   @default("vlm-zai")
  imageUrl        String?  // the image that was analyzed
  location        String?  // JSON { lat, lng, name }
  processingMs    Int      @default(0)
  // status: pending | processed | published | dismissed
  status          String   @default("published")
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([severity])
  @@index([confidence])
  @@index([status])
  @@index([detectionResultId])
  @@index([intelligenceEventId])
  @@index([createdAt])
}

// =============================================================================
// MILESTONE 15 — Evidence Fusion Engine
// =============================================================================
// Merges evidence from multiple sources (AI, Citizens, Satellite, Drone,
// Sensors, Government inspections) into one fused confidence score.
// Uses weighted Bayesian fusion with conflict detection.
// =============================================================================

model FusionSource {
  id              String   @id @default(cuid())
  fusionResultId  String
  // sourceType: ai_detection | citizen_report | satellite_imagery | drone_survey | sensor_log | government_inspection | corroboration
  sourceType      String
  // sourceId: reference to the source record (detection result ID, evidence ID, intel event ID, etc.)
  sourceId        String?
  // raw confidence from this source (0.0-1.0)
  rawConfidence   Float
  // weight assigned to this source type (0.0-1.0, based on source reliability)
  weight          Float
  // weighted contribution to the fused score
  weightedScore   Float
  // metadata
  description     String?
  sourceTimestamp DateTime?
  metadata        String?  // JSON
  createdAt       DateTime @default(now())

  fusionResult    FusionResult @relation(fields: [fusionResultId], references: [id], onDelete: Cascade)

  @@index([fusionResultId])
  @@index([sourceType])
}

model FusionResult {
  id              String   @id @default(cuid())
  // target: what is being fused (e.g. an intelligence event, a twin entity, a location)
  targetType      String   // intelligence_event | twin_entity | location | observation
  targetId        String?
  // the fused confidence (0.0-1.0) — the single number from merging all sources
  fusedConfidence Float    @default(0)
  // fused severity
  fusedSeverity   String   @default("medium") // low | medium | high | critical
  // number of sources fused
  sourceCount     Int      @default(0)
  // source breakdown
  sourceBreakdown String   // JSON: { ai: n, citizen: n, satellite: n, drone: n, sensor: n, government: n }
  // conflict detection
  hasConflict     Boolean  @default(false)
  conflictDetails String?  // JSON: { sources: [...], spread: number, description: string }
  // consensus
  consensusLevel  String   @default("unanimous") // unanimous | strong | moderate | weak | divided
  // location (optional — for spatial fusion)
  lat             Float?
  lng             Float?
  locationName    String?
  // linked intelligence event
  intelligenceEventId String?
  // metadata
  algorithm       String   @default("weighted_bayesian")
  metadata        String?  // JSON
  createdAt       DateTime @default(now())

  sources         FusionSource[]

  @@index([targetType])
  @@index([fusedConfidence])
  @@index([hasConflict])
  @@index([consensusLevel])
  @@index([createdAt])
}

// =============================================================================
// MILESTONE 16 — Environmental Intelligence
// =============================================================================
// Predictive analytics for environmental impact modeling:
// sediment flow, river impact, forest loss, downstream effects, protected area risk.
// Uses real data from M4 twin entities, M6 knowledge graph, M12 satellite,
// M13 CV detections, and M15 fusion results.
// =============================================================================

model EnvironmentalPrediction {
  id              String   @id @default(cuid())
  // type: sediment | river_impact | forest_loss | downstream_effects | protected_area_risk
  type            String
  // target entity (river, forest, protected area, mine)
  targetEntityId  String?
  targetName      String
  targetType      String   // river | forest | protected_area | mine | community
  // prediction
  prediction      String   // human-readable prediction text
  riskScore       Float    @default(0) // 0.0-1.0 (0=safe, 1=critical)
  riskLevel       String   @default("low") // low | moderate | high | critical
  confidence      Float    @default(0) // 0.0-1.0
  // timeline: when the impact is expected
  timeframe       String   @default("immediate") // immediate | 1-3 months | 3-6 months | 6-12 months | 1+ years
  // factors: JSON breakdown of what drives the prediction
  factors         String   // JSON: { factor_name: { value, weight, contribution } }
  // input data references
  inputEntityIds  String?  // JSON array of twin entity IDs used
  inputSatelliteScenes String? // JSON array of satellite scene IDs
  inputDetections String?  // JSON array of detection result IDs
  inputFusionIds  String?  // JSON array of fusion result IDs
  // affected entities (predicted impact zone)
  affectedEntities String? // JSON: [{ entityId, name, type, impactLevel }]
  // metadata
  model           String   @default("env-intel-v1")
  algorithm       String   @default("weighted_multi_factor")
  metadata        String?  // JSON
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([riskLevel])
  @@index([riskScore])
  @@index([targetEntityId])
  @@index([createdAt])
}

// =============================================================================
// MILESTONE 17 — Prediction Engine
// =============================================================================
// Predicts illegal mining hotspots and future expansion with probability,
// confidence, and full explainability. Uses spatial clustering of existing
// mines, CV detections, environmental predictions, and satellite data.
// =============================================================================

model HotspotPrediction {
  id              String   @id @default(cuid())
  // type: hotspot | expansion
  type            String
  // location
  lat             Float
  lng             Float
  locationName    String?
  // prediction
  prediction      String   // human-readable
  probability     Float    @default(0) // 0.0-1.0 — likelihood of illegal mining
  confidence      Float    @default(0) // 0.0-1.0 — model confidence in the prediction
  riskLevel       String   @default("low") // low | moderate | high | critical
  // expansion forecast
  expansionDirection String? // N | NE | E | SE | S | SW | W | NW | radial
  expansionRadiusKm Float?  // predicted expansion radius in km
  expansionTimeframe String? // immediate | 1-3 months | 3-6 months | 6-12 months
  // explainability — full breakdown of WHY this prediction was made
  explanation     String   // structured explanation text
  explanationSteps String? // JSON array of step-by-step reasoning
  factors         String   // JSON: [{ name, value, weight, contribution, description }]
  // input data
  inputMineIds    String?  // JSON array of mine entity IDs
  inputDetectionIds String? // JSON array of CV detection IDs
  inputPredictionIds String? // JSON array of environmental prediction IDs
  inputSatelliteIds String? // JSON array of satellite scene IDs
  inputFusionIds  String?  // JSON array of fusion result IDs
  // nearby entities at risk
  atRiskEntities  String?  // JSON: [{ entityId, name, type, distanceKm, riskLevel }]
  // model metadata
  model           String   @default("hotspot-v1")
  algorithm       String   @default("spatial_cluster_bayesian")
  metadata        String?  // JSON
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([riskLevel])
  @@index([probability])
  @@index([confidence])
  @@index([lat, lng])
  @@index([createdAt])
}

// =============================================================================
// MILESTONE 18 — Digital Twin AI Copilot
// =============================================================================
// Natural language interface to the Digital Twin. Users ask questions like
// "Show illegal mining near Pra River" or "Why is this event high confidence?"
// and the copilot uses the LLM + real platform data to answer.
// =============================================================================

model CopilotConversation {
  id              String   @id @default(cuid())
  userId          String?
  title           String   @default("New Conversation")
  // context: JSON — what entities/events the conversation is about
  context         String?  // JSON: { entityIds: [], eventIds: [], type: "" }
  messageCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages        CopilotMessage[]

  @@index([userId])
  @@index([createdAt])
}

model CopilotMessage {
  id              String   @id @default(cuid())
  conversationId  String
  // role: user | assistant
  role            String
  content         String
  // context data retrieved for this query (JSON)
  retrievedData   String?  // JSON: summary of data fetched from the platform
  // entities referenced in the response
  referencedEntities String? // JSON array of entity IDs
  referencedEvents String?  // JSON array of event IDs
  // model metadata
  model           String   @default("llm-zai")
  processingMs    Int      @default(0)
  createdAt       DateTime @default(now())

  conversation    CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
  @@index([createdAt])
}

// =============================================================================
// MILESTONE 19 — Mission System
// =============================================================================
// When confidence is low, AI creates missions to gather additional evidence.
// Example: "Need additional evidence within 500m of Pra River contamination."
// Nearby trusted users receive the mission. Mission rewards depend on
// verification quality — higher trust tier + better evidence = bigger reward.
// =============================================================================

model Mission {
  id              String   @id @default(cuid())
  key             String   @unique
  title           String
  description     String
  // AI-generated mission instructions
  instructions    String   // what the user should do (e.g. "Photograph the water at this GPS location")
  // type: evidence_gathering | verification | inspection | drone_survey | sensor_check | witness_interview
  type            String   @default("evidence_gathering")
  // priority: low | medium | high | urgent
  priority        String   @default("medium")
  // trigger: what caused this mission to be created
  triggerType     String   @default("low_confidence") // low_confidence | conflict_detected | ai_observation | manual
  triggerId       String?  // fusion result ID, observation ID, etc.
  triggerDescription String? // "Fused confidence 45% — need more evidence"
  // target location
  lat             Float?
  lng             Float?
  radiusM         Int      @default(500) // radius in meters for "within 500m"
  locationName    String?
  // linked entities
  intelligenceEventId String?
  twinEntityId    String?
  // reward system
  baseReward      Int      @default(100) // base reward in trust points
  maxReward       Int      @default(500) // max reward with quality bonus
  rewardCurrency  String   @default("trust_points")
  // reward modifiers based on verification quality
  qualityMultiplier Float  @default(1.0) // 0.5-2.0 based on evidence quality
  // status: open | assigned | in_progress | submitted | verified | completed | expired | cancelled
  status          String   @default("open")
  // timing
  expiresAt       DateTime?
  acceptedAt      DateTime?
  submittedAt     DateTime?
  verifiedAt      DateTime?
  completedAt     DateTime?
  // assignment
  assignedToId    String?  // user assigned to the mission
  assignedAt      DateTime?
  // submission
  submissionNotes String?
  submissionEvidenceIds String? // JSON array of evidence IDs submitted
  submissionLat   Float?
  submissionLng   Float?
  // verification
  verifiedById    String?
  verificationNotes String?
  verificationQuality String? // low | medium | high | excellent
  actualReward    Int?     // final reward paid (base × quality multiplier)
  // AI metadata
  model           String   @default("mission-ai-v1")
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([assignedToId])
  @@index([triggerType])
  @@index([lat, lng])
  @@index([createdAt])
}

model MissionAssignment {
  id              String   @id @default(cuid())
  missionId       String
  userId          String
  // assignment status: offered | accepted | declined | expired
  status          String   @default("offered")
  // user's trust tier when offered (affects eligibility)
  userTrustTier   String   @default("basic")
  userDistanceKm  Float?   // distance from user to mission location
  // notification
  notifiedAt      DateTime @default(now())
  respondedAt     DateTime?
  createdAt       DateTime @default(now())

  @@unique([missionId, userId])
  @@index([missionId])
  @@index([userId])
  @@index([status])
}

model MissionRewardLog {
  id              String   @id @default(cuid())
  missionId       String
  userId          String
  // reward details
  baseReward      Int
  qualityMultiplier Float
  actualReward    Int
  qualityLevel    String   // low | medium | high | excellent
  // trust impact
  trustPointsAwarded Int
  // metadata
  awardedAt       DateTime @default(now())
  metadata        String?  // JSON

  @@index([missionId])
  @@index([userId])
  @@index([awardedAt])
}

// =============================================================================
// MILESTONE 20 — Reward Engine
// =============================================================================
// Transparent reward distribution from donation pools, NGO funding, and
// government grants. No cryptocurrency — fiat-based with audit ledger.
// Event-specific contribution scoring ensures fair, merit-based payouts.
// =============================================================================

model RewardPool {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  description     String?
  // type: donation | ngo_funding | government_grant | mission_rewards | community_fund
  type            String
  // source: who provided the funds
  sourceName      String   // e.g. "WACAM Ghana", "EPA Ghana", "UNDP"
  sourceType      String   // ngo | government | international | community | individual
  sourceOrganizationId String?
  // funds
  totalFunds      Float    @default(0) // total deposited (in GHS — Ghana Cedis)
  availableFunds  Float    @default(0) // remaining after distributions
  distributedFunds Float   @default(0) // cumulative distributed
  currency        String   @default("GHS")
  // allocation rules
  // distributionModel: proportional | equal | merit_based | first_come
  distributionModel String @default("merit_based")
  // event-specific: if linked to an intelligence event, contributions are scored per event
  intelligenceEventId String?
  // status: active | depleted | paused | closed
  status          String   @default("active")
  // transparency
  isPublic        Boolean  @default(true)
  // timing
  opensAt         DateTime?
  closesAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contributions   RewardContribution[]
  distributions   RewardDistribution[]
  ledger          RewardLedger[]

  @@index([type])
  @@index([status])
  @@index([sourceType])
  @@index([intelligenceEventId])
}

model RewardContribution {
  id              String   @id @default(cuid())
  poolId          String
  userId          String?
  organizationId  String?
  // contributor info
  contributorName String
  contributorType String   // user | ngo | government | international | community
  // contribution
  amount          Float    // amount contributed (GHS)
  currency        String   @default("GHS")
  // contribution score: how much this contribution is "worth" in the merit system
  // Factors: trust tier of contributor × amount × evidence quality multiplier
  contributionScore Float  @default(0)
  // what the contribution is for (specific evidence, mission, or general)
  contributionType String  @default("financial") // financial | evidence | mission_completion | verification | referral
  // linked evidence/mission (if applicable)
  evidenceId      String?
  missionId       String?
  // metadata
  description     String?
  metadata        String?  // JSON
  createdAt       DateTime @default(now())

  pool            RewardPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId])
  @@index([userId])
  @@index([contributionType])
  @@index([createdAt])
}

model RewardDistribution {
  id              String   @id @default(cuid())
  poolId          String
  recipientId     String   // user ID receiving the reward
  recipientName   String
  recipientTrustTier String?
  // amount
  amount          Float    // amount distributed (GHS)
  currency        String   @default("GHS")
  // distribution basis
  distributionModel String  // merit_based | proportional | equal | first_come
  contributionScore Float   // the score that earned this distribution
  qualityLevel    String?   // low | medium | high | excellent (from mission verification)
  // linked mission/event
  missionId       String?
  intelligenceEventId String?
  // transparency
  transactionRef  String?  // bank transfer / mobile money reference
  distributedById String?  // who authorized the distribution
  distributedAt   DateTime @default(now())
  // status: pending | processing | completed | failed | reversed
  status          String   @default("completed")
  notes           String?
  metadata        String?  // JSON

  pool            RewardPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId])
  @@index([recipientId])
  @@index([status])
  @@index([distributedAt])
}

model RewardLedger {
  id              String   @id @default(cuid())
  poolId          String
  // entryType: deposit | distribution | adjustment | reversal | fee
  entryType       String
  amount          Float    // positive for deposits, negative for distributions
  balance         Float    // running balance after this entry
  // parties
  fromName        String?
  toName          String?
  fromId          String?
  toId            String?
  // reference
  referenceType   String?  // contribution | distribution | manual
  referenceId     String?  // contribution ID or distribution ID
  description     String
  // audit
  authorizedBy    String?
  transactionRef  String?  // bank/mobile money reference
  metadata        String?  // JSON
  // hash chain for tamper-evidence (same pattern as evidence M7)
  entryHash       String?
  prevHash        String?
  createdAt       DateTime @default(now())

  pool            RewardPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId])
  @@index([entryType])
  @@index([createdAt])
  @@index([entryHash])
}

// =============================================================================
// MILESTONE 21 — Fraud Detection AI
// =============================================================================
// Detects seven classes of fraud across the Sentinel platform:
//   1. Fake evidence   — manipulated, duplicated, or fabricated evidence
//   2. Collusion       — multiple users coordinating to manipulate evidence
//   3. Sockpuppets     — one user controlling multiple accounts
//   4. Location spoofing — GPS coordinates that don't match reality
//   5. Deepfakes       — AI-generated images/video detected as synthetic
//   6. Vote rings      — coordinated corroboration rings (circular support)
//   7. Reward farming  — low-quality submissions to farm reward pools
//
// Each alert groups multiple signals from different detectors. Alerts are
// investigated, resolved, and feed into UserRiskProfile for trust penalties.
// =============================================================================

model FraudAlert {
  id              String   @id @default(cuid())
  key             String   @unique // human-readable, e.g. "fraud-prestea-collusion-001"
  // type: fake_evidence | collusion | sockpuppet | location_spoofing | deepfake | vote_ring | reward_farming
  type            String
  // severity: low | medium | high | critical
  severity        String   @default("medium")
  // status: detected | investigating | confirmed | dismissed | resolved | escalated
  status          String   @default("detected")
  title           String
  description     String
  // confidence: 0.0–1.0 — how confident the AI is that this is real fraud
  confidence      Float    @default(0.5)
  // riskScore: 0.0–1.0 — overall risk to the platform
  riskScore       Float    @default(0.5)
  // primary suspect
  targetUserId    String?
  // all involved users (JSON array of user IDs)
  targetUserIds   String?  // JSON
  // affected entities (JSON array of evidence IDs, mission IDs, event IDs)
  targetEntityIds String?  // JSON
  // signal count
  signalCount     Int      @default(0)
  // estimated financial impact (GHS) — for reward farming / fraud that affected payouts
  estimatedImpactGHS Float @default(0)
  // AI detection metadata
  model           String   @default("fraud-ai-v1")
  detectorVersion String   @default("1.0.0")
  metadata        String?  // JSON
  // investigation
  investigation   FraudInvestigation?
  signals         FraudSignal[]
  // resolution
  detectedAt      DateTime @default(now())
  resolvedAt      DateTime?
  resolvedById    String?
  resolution      String?  // dismissed | confirmed | escalated | user_warned | user_suspended | rewards_revoked
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([targetUserId])
  @@index([detectedAt])
  @@index([confidence])
}

model FraudSignal {
  id              String   @id @default(cuid())
  alertId         String
  // signalType: hash_duplicate | metadata_mismatch | impossible_travel | identical_timestamp |
  //             shared_device | shared_ip | timing_pattern | gps_metadata_mismatch |
  //             ai_artifact | facial_inconsistency | coordinated_voting |
  //             circular_corroboration | bulk_submission | low_quality_spam | repeated_evidence
  signalType      String
  // detector: which detector method found this signal
  detector        String
  // confidence: 0.0–1.0 — how strong this individual signal is
  confidence      Float    @default(0.5)
  // weight: 0.0–1.0 — how much this signal contributes to the alert's overall risk
  weight          Float    @default(0.5)
  description     String
  // evidence: JSON — supporting data (user IDs, evidence IDs, timestamps, distances, hashes)
  evidence        String?  // JSON
  detectedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  alert           FraudAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@index([signalType])
  @@index([detector])
  @@index([confidence])
}

model FraudInvestigation {
  id              String   @id @default(cuid())
  alertId         String   @unique
  // status: open | in_progress | pending_review | closed
  status          String   @default("open")
  assignedToId    String?  // investigator user ID
  openedAt        DateTime @default(now())
  closedAt        DateTime?
  // findings: JSON — investigator notes, evidence reviewed, interviews
  findings        String?  // JSON
  // recommendedAction: dismiss | warn_user | suspend_user | revoke_rewards | escalate_to_admin | refer_to_authorities
  recommendedAction String?
  // penaltyApplied: trust score penalty applied (0.0–1.0)
  penaltyApplied  Float    @default(0.0)
  // rewardsRevoked: GHS amount revoked from the user
  rewardsRevoked  Float    @default(0)
  // userSuspended: whether the user was suspended
  userSuspended   Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  alert           FraudAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([assignedToId])
}

model UserRiskProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  // riskScore: 0.0–1.0 — overall fraud risk
  riskScore       Float    @default(0.0)
  // riskLevel: clean | low_risk | moderate_risk | high_risk | critical
  riskLevel       String   @default("clean")
  // alert metrics
  alertCount      Int      @default(0)
  confirmedAlertCount Int  @default(0)
  dismissedAlertCount Int  @default(0)
  // signalsByType: JSON — { fake_evidence: 2, collusion: 1, ... }
  signalsByType   String?  // JSON
  // penalty
  trustPenalty    Float    @default(0.0) // 0.0–1.0 trust score penalty
  rewardsRevoked  Float    @default(0)   // GHS total revoked
  // factors: JSON breakdown of how risk was computed
  factors         String?  // JSON
  lastAlertAt     DateTime?
  lastCalculatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([riskScore])
  @@index([riskLevel])
}

// =============================================================================
// MILESTONE 22 — Government Operations Center
// =============================================================================
// Three-tier government dashboard (National → Regional → District) with
// investigation workflow, inspection workflow, and case management.
//
// Investigations: formal inquiries into illegal mining/environmental crime,
//   triggered by intelligence events, fraud alerts, or citizen reports.
//   Multi-step workflow: opened → investigating → findings → recommended_action → closed.
// Inspections: field visits to verify reported incidents, with findings,
//   photos, GPS, and compliance assessment.
// Cases: legal/administrative cases that aggregate investigations + inspections +
//   evidence into a single trackable unit with status, priority, and resolution.
// =============================================================================

model Investigation {
  id              String   @id @default(cuid())
  key             String   @unique // e.g. "inv-prestea-galamsey-001"
  title           String
  description     String
  // type: illegal_mining | water_pollution | deforestation | land_degradation | mercury_use | child_labor | tax_evasion | other
  type            String
  // status: open | investigating | pending_review | recommended_action | closed | escalated
  status          String   @default("open")
  // priority: low | medium | high | urgent
  priority        String   @default("medium")
  // trigger: what caused this investigation
  triggerType     String   // intelligence_event | fraud_alert | citizen_report | satellite_change | cv_detection | mission_result | manual
  triggerId       String?
  triggerDescription String?
  // location
  lat             Float?
  lng             Float?
  locationName    String?
  region          String?  // e.g. "Western"
  district        String?  // e.g. "Prestea-Huni Valley"
  // jurisdiction
  level           String   @default("regional") // national | regional | district
  agencyId        String?  // lead agency (Organization ID)
  agencyName      String?
  // assignment
  leadInvestigatorId String?
  leadInvestigatorName String?
  assignedAt      DateTime?
  // linked entities
  intelligenceEventId String?
  twinEntityId    String?
  fraudAlertId    String?
  // outcome
  findings        String?  // JSON — structured findings
  recommendedAction String? // warning | fine | shutdown | prosecution | referral
  estimatedImpactGHS Float @default(0)
  // resolution
  closedAt        DateTime?
  closedById      String?
  resolution      String?  // dismissed | warning_issued | fine_imposed | shutdown_ordered | prosecuted | referred
  resolutionNotes String?
  // metadata
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  steps           InvestigationStep[]
  inspections     Inspection[]
  cases           CaseInvestigation[]

  @@index([status])
