// =============================================================================
// MILESTONE 26 — Security Hardening
// =============================================================================
// Comprehensive security platform covering 10 domains:
//   1. Zero Trust       — never trust, always verify (mTLS, device posture)
//   2. Encryption       — at rest (AES-256) + in transit (TLS 1.3)
//   3. Rate Limiting    — per-API-key, per-IP, per-user throttling
//   4. WAF              — Web Application Firewall (OWASP Top 10 protection)
//   5. Secret Rotation  — automatic key/secret rotation with audit trail
//   6. Pen Testing      — scheduled + ad-hoc penetration test reports
//   7. Threat Detection — intrusion detection, anomaly detection, SIEM
//   8. Backups          — automated encrypted backups with retention
//   9. Disaster Recovery — RPO/RTO tracking, failover readiness
//  10. Audit            — immutable security audit log (tamper-evident)
// =============================================================================

model SecurityEvent {
  id              String   @id @default(cuid())
  // domain: zero_trust | encryption | rate_limiting | waf | secret_rotation | pen_testing | threat_detection | backup | disaster_recovery | audit
  domain          String
  // type: specific event type (e.g. "failed_login", "waf_blocked", "key_rotated")
  type            String
  // severity: info | low | medium | high | critical
  severity        String   @default("info")
  // status: active | acknowledged | resolved | false_positive
  status          String   @default("active")
  title           String
  description     String
  // source
  sourceIp        String?
  sourceUserId    String?
  sourceService   String?
  // target
  targetResource  String?  // e.g. "/api/v1/evidence", "database", "admin-panel"
  // details JSON
  details         String?  // JSON
  // mitigation
  mitigatedAt     DateTime?
  mitigatedById   String?
  mitigationNotes String?
  // metadata
  metadata        String?  // JSON
  detectedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([domain])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
  @@index([sourceIp])
}

model SecurityPolicy {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  domain          String
  description     String
  // policy config JSON
  config          String   // JSON
  // enforcement
  enforcementMode String   @default("enforce") // enforce | monitor | disabled
  // status
  isActive        Boolean  @default(true)
  // compliance
  complianceScore Float    @default(1.0) // 0.0-1.0
  lastCheckedAt   DateTime?
  lastViolatedAt  DateTime?
  violationCount  Int      @default(0)
  // metadata
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([domain])
  @@index([isActive])
  @@index([enforcementMode])
}

model ThreatIndicator {
  id              String   @id @default(cuid())
  // type: brute_force | credential_stuffing | sql_injection | xss | ddos | bot | scrapting | privilege_escalation | data_exfiltration | malware | anomalous_access
  type            String
  // severity: low | medium | high | critical
  severity        String   @default("medium")
  status          String   @default("active") // active | blocked | resolved | false_positive
  title           String
  description     String
  // source
  sourceIp        String?
  sourceCountry   String?
  sourceUserId    String?
  // IoC (Indicators of Compromise)
  iocType         String?  // ip | user_agent | pattern | hash | domain
  iocValue        String?
  // target
  targetEndpoint  String?
  targetUserId    String?
  // detection
  detectionMethod String?  // siem | waf | ids | anomaly | manual
  confidence      Float    @default(0.5)
  // mitigation
  blockedAt       DateTime?
  blockDuration   Int?     // seconds
  // metadata
  metadata        String?  // JSON
  detectedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([sourceIp])
  @@index([detectedAt])
}

model BackupRecord {
  id              String   @id @default(cuid())
  key             String   @unique
  // type: full | incremental | differential | snapshot
  type            String
  // target: database | storage | config | full_system
  target          String
  // status: scheduled | in_progress | completed | failed | verified | expired
  status          String   @default("scheduled")
  // storage
  sizeBytes       Int      @default(0)
  compressedSizeBytes Int  @default(0)
  storageLocation String?
  storageProvider String   @default("local") // local | s3 | azure | gcp
