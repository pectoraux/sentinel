  encrypted       Boolean  @default(true)
  encryptionKeyId String?
  checksum        String?
  // retention
  retentionDays   Int      @default(30)
  expiresAt       DateTime?
  // verification
  verifiedAt      DateTime?
  verifiedById    String?
  verificationStatus String? // passed | failed | pending
  // timing
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  // metadata
  metadata        String?  // JSON
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([target])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
}

model PenTestReport {
