  remediatedCount Int      @default(0)
  remediationDueAt DateTime?
  // metadata
  metadata        String?  // JSON
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([testDate])
  @@index([remediationStatus])
}

model SecretRotation {
  id              String   @id @default(cuid())
  key             String   @unique
  // secretType: api_key | jwt_secret | database_password | encryption_key | tls_cert | oauth_secret | webhook_secret
  secretType      String
  secretName      String
  description     String?
  // rotation
  rotationStatus  String   @default("scheduled") // scheduled | in_progress | completed | failed
  rotationIntervalDays Int @default(90)
  lastRotatedAt   DateTime?
  nextRotationAt  DateTime?
  rotatedById     String?
  // versioning
  currentVersion  Int      @default(1)
  previousVersion Int?
  // verification
  verifiedAt      DateTime?
  verificationStatus String? // passed | failed | pending
  // metadata
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([secretType])
  @@index([rotationStatus])
  @@index([nextRotationAt])
}

model DisasterRecoveryPlan {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  description     String
  // type: failover | backup_restore | regional | full_system
  type            String
  // RPO/RTO targets
  rpoMinutes      Int      @default(60) // Recovery Point Objective
  rtoMinutes      Int      @default(240) // Recovery Time Objective
  // last test
  lastTestedAt    DateTime?
  lastTestStatus  String?  // passed | failed | partial
  lastTestDurationMin Int?
  // readiness
  readinessScore  Float    @default(0.0) // 0.0-1.0
  readinessStatus String   @default("unknown") // ready | degraded | not_ready | unknown
  // steps
  steps           String?  // JSON array of recovery steps
  // metadata
  metadata        String?  // JSON
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([readinessStatus])
  @@index([isActive])
}

// =============================================================================
// MILESTONE 27 — Performance Hardening
// =============================================================================
// Scales the platform to millions of users, millions of events, and petabyte
// imagery. Covers 6 domains:
//   1. Users          — concurrent user capacity, auth throughput
//   2. Events         — intelligence event ingestion rate, query throughput
//   3. Imagery        — satellite imagery storage (petabyte), tile serving
//   4. Caching        — multi-layer cache (CDN, Redis, app-level) hit rates
//   5. Horizontal Scaling — auto-scaling, load balancer, partitioning
//   6. Optimization   — query optimization, index tuning, N+1 elimination
// =============================================================================

model PerfMetric {
  id              String   @id @default(cuid())
  // domain: users | events | imagery | caching | scaling | optimization
  domain          String
  // metric name, e.g. "concurrent_users", "p99_latency", "cache_hit_rate"
  metric          String
  // current value
  value           Float
  unit            String   // count | ms | req/s | GB | TB | % | MB/s
  // target/benchmark
  target          Float?
  targetLabel     String?
  // trend: up | down | flat
  trend           String   @default("flat")
  trendPct        Float    @default(0)
  // status: good | warning | critical
  status          String   @default("good")
  // capacity tier: current | projected_6mo | projected_12mo
  capacityTier    String   @default("current")
  // description
  description     String?
  // timestamp
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([domain])
  @@index([metric])
  @@index([status])
  @@index([capacityTier])
  @@index([recordedAt])
}

model LoadTestRun {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  description     String?
  // type: stress | spike | soak | ramp | capacity
  type            String
  // status: scheduled | running | completed | failed | aborted
  status          String   @default("completed")
  // test config
  targetEndpoint  String
  concurrentUsers Int
  durationSec     Int
  rampUpSec       Int      @default(60)
  // results
  totalRequests   Int      @default(0)
  successfulReqs  Int      @default(0)
  failedReqs      Int      @default(0)
  // latency (ms)
  avgLatencyMs    Float    @default(0)
  p50LatencyMs    Float    @default(0)
  p95LatencyMs    Float    @default(0)
  p99LatencyMs    Float    @default(0)
  minLatencyMs    Float    @default(0)
  maxLatencyMs    Float    @default(0)
  // throughput
  requestsPerSec  Float    @default(0)
  // errors
  errorRate       Float    @default(0) // %
  errorBreakdown  String?  // JSON
  // resource usage
  cpuUsagePct     Float    @default(0)
  memoryUsagePct  Float    @default(0)
  dbConnections   Int      @default(0)
  // pass/fail
  passed          Boolean  @default(true)
  passCriteria    String?  // JSON
  // timing
  startedAt       DateTime?
  completedAt     DateTime?
  durationActual  Int?     // actual duration in seconds
  // metadata
  metadata        String?  // JSON
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([passed])
  @@index([createdAt])
}

model CacheStats {
  id              String   @id @default(cuid())
  // layer: cdn | redis | app | database | browser
  layer           String
  // cache name, e.g. "tile-cache", "evidence-cache", "api-response-cache"
  cacheName       String
  // stats
  hitCount        Int      @default(0)
  missCount       Int      @default(0)
  hitRate         Float    @default(0) // %
  evictionCount   Int      @default(0)
  // size
  sizeBytes       Int      @default(0)
  maxBytes        Int      @default(0)
  entryCount      Int      @default(0)
  // performance
  avgGetLatencyMs Float    @default(0)
  avgSetLatencyMs Float    @default(0)
  // TTL
  defaultTtlSec   Int      @default(300)
  // status
  status          String   @default("healthy") // healthy | degraded | critical
  // timing
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([layer])
  @@index([cacheName])
  @@index([status])
  @@index([recordedAt])
}

model ScalingEvent {
  id              String   @id @default(cuid())
  key             String   @unique
  // type: scale_up | scale_down | auto_scale | failover | partition | migration
  type            String
  // resource: web-server | api-server | database | cache | storage | worker
  resource        String
  // trigger: cpu_threshold | memory_threshold | queue_depth | manual | scheduled | traffic_spike
  trigger         String
  description     String
  // scaling details
  fromCount       Int      @default(1)
  toCount         Int      @default(1)
  // status: completed | in_progress | failed | rolled_back
  status          String   @default("completed")
  // timing
  triggeredAt     DateTime @default(now())
  completedAt     DateTime?
  durationSec     Int?
  // impact
  impactNotes     String?
  // metadata
  metadata        String?  // JSON
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([resource])
  @@index([status])
  @@index([triggeredAt])
}

model OptimizationRecord {
  id              String   @id @default(cuid())
  key             String   @unique
  title           String
  description     String
  // type: query_optimization | index_addition | n+1_fix | caching_addition | code_optimization | bundle_size | image_optimization | lazy_load
  type            String
  // target: what was optimized
  target          String   // e.g. "/api/v1/evidence", "evidence.list()", "tile-serving"
  // status: proposed | in_progress | completed | reverted
  status          String   @default("proposed")
  // metrics before
  beforeMetric    Float?
  afterMetric     Float?
  metricUnit      String?  // ms | MB | req/s
  metricName      String?  // e.g. "p95_latency", "bundle_size", "query_time"
  // improvement
  improvementPct  Float?   // % improvement
  // impact
  impactLevel     String   @default("medium") // low | medium | high | critical
  impactNotes     String?
  // ownership
  proposedById    String?
  implementedById String?
  // timing
  proposedAt      DateTime @default(now())
  implementedAt   DateTime?
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([impactLevel])
  @@index([createdAt])
}

// =============================================================================
// MILESTONE 28 — Production Readiness
// =============================================================================
// Final production readiness across 8 domains:
//   1. Accessibility     — WCAG 2.1 AA compliance, screen reader, keyboard nav
//   2. Internationalization — multi-language, RTL, locale-specific formatting
//   3. Offline-First     — PWA, service worker, offline data sync
//   4. Mobile Optimization — responsive, touch, performance on mobile
//   5. Monitoring        — observability, alerting, dashboards, SLO tracking
//   6. Incident Response — severity, on-call, postmortem, MTTR tracking
//   7. Operational Runbooks — documented procedures for common operations
//   8. Final Production Audit — comprehensive go/no-go checklist
// =============================================================================

model ProdReadinessCheck {
  id              String   @id @default(cuid())
  // domain: accessibility | i18n | offline | mobile | monitoring | incident_response | runbooks | audit
  domain          String
  // check name, e.g. "wcag_keyboard_nav", "pwa_service_worker"
  checkName       String
  description     String
  // status: passed | warning | failed | pending | not_applicable
  status          String   @default("pending")
  // compliance level: A | AA | AAA | N/A
  complianceLevel String?
  // details
  details         String?  // JSON
  // remediation
  remediation     String?
  remediationOwner String?
  remediationDueAt DateTime?
  // metadata
  metadata        String?  // JSON
  checkedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([domain])
  @@index([status])
  @@index([complianceLevel])
  @@index([checkedAt])
}

model IncidentReport {
  id              String   @id @default(cuid())
  key             String   @unique
  title           String
  description     String
  // severity: SEV1 | SEV2 | SEV3 | SEV4 | SEV5
  severity        String
  // status: detected | investigating | mitigated | resolved | postmortem
  status          String   @default("detected")
  // impact
  impactSummary   String?
  affectedServices String? // JSON array
  affectedUsers   Int      @default(0)
  // timing
  detectedAt      DateTime @default(now())
  acknowledgedAt  DateTime?
  mitigatedAt     DateTime?
  resolvedAt      DateTime?
  // MTTR (Mean Time To Resolution) in minutes
  mttrMinutes     Int?
  // on-call
  oncallEngineer  String?
  incidentCommander String?
  // root cause
  rootCause       String?
  actionItems     String?  // JSON array
  postmortemUrl   String?
  // metadata
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([severity])
  @@index([status])
  @@index([detectedAt])
  @@index([oncallEngineer])
}

model Runbook {
  id              String   @id @default(cuid())
  key             String   @unique
  title           String
  description     String
  // category: deployment | scaling | recovery | security | data | monitoring | maintenance
  category        String
  // content (markdown)
  content         String
  // steps JSON array
  steps           String?  // JSON: [{ step, action, expected, rollback }]
  // metadata
  estimatedTime   Int?     // minutes
  lastTestedAt    DateTime?
  lastUpdatedBy   String?
  // status
  status          String   @default("active") // active | draft | deprecated
  version         Int      @default(1)
  // metadata
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([version])
}

model AccessibilityAudit {
  id              String   @id @default(cuid())
  key             String   @unique
  title           String
  description     String
  // page/route audited
  pageUrl         String
  // WCAG level targeted: A | AA | AAA
  targetLevel     String   @default("AA")
  // results
  totalChecks     Int      @default(0)
  passedChecks    Int      @default(0)
  failedChecks    Int      @default(0)
  warningChecks   Int      @default(0)
  // compliance score 0-100
  complianceScore Float    @default(0)
  achievedLevel   String?  // A | AA | AAA | none
  // findings
  findings        String?  // JSON array of detailed findings
  // status
  status          String   @default("completed") // scheduled | in_progress | completed
  // metadata
  auditedBy       String?
  auditedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([pageUrl])
  @@index([status])
  @@index([achievedLevel])
  @@index([complianceScore])
}

model I18nLocale {
  id              String   @id @default(cuid())
  // locale code, e.g. "en", "fr", "sw", "tw"
  locale          String   @unique
  language        String   // e.g. "English", "French", "Swahili", "Twi"
  nativeName      String   // e.g. "English", "Français", "Kiswahili"
  // direction: ltr | rtl
  direction       String   @default("ltr")
  // translation completeness 0-100
  translationPct  Float    @default(0)
  // status: active | draft | planned
  status          String   @default("planned")
  // stats
  totalKeys       Int      @default(0)
  translatedKeys  Int      @default(0)
  missingKeys     Int      @default(0)
  // metadata
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([translationPct])
}

model DeploymentPipeline {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  description     String?
  // environment: staging | production | preview
  environment     String
  // status: idle | building | deploying | success | failed | rolled_back
  status          String   @default("idle")
  // version
  version         String?
  commitSha       String?
  branch          String?
  // stages JSON: [{ name, status, durationSec, logs }]
  stages          String?  // JSON
  // timing
  triggeredAt     DateTime?
  completedAt     DateTime?
  durationSec     Int?
  triggeredBy     String?
  // result
  deploymentUrl   String?
  rollbackUrl     String?
  // metadata
  metadata        String?  // JSON
  createdAt       DateTime @default(now())

  @@index([environment])
  @@index([status])
  @@index([createdAt])
}

// =============================================================================
// AUTONOMOUS INVESTIGATION ENGINE
// =============================================================================
// When an Intelligence Event is created — by a citizen or by the Digital Twin —
// the AI automatically becomes an investigator. It:
//   1. Gathers nearby historical events (spatial + temporal context)
//   2. Compares recent satellite imagery with older imagery (change detection)
//   3. Identifies affected rivers, forests, and communities (impact analysis)
//   4. Requests additional evidence from trusted nearby contributors (auto-missions)
//   5. Explains why it believes the event is credible (or not) — reasoning chain
//   6. Continuously updates confidence as new evidence arrives (Bayesian updates)
//   7. Recommends the next best action (dispatch inspector, drone, wait, escalate)
//
// This transforms Sentinel from a reporting platform into an AI-powered
// environmental investigation system.
// =============================================================================

model AutonomousInvestigation {
  id              String   @id @default(cuid())
  key             String   @unique
  title           String
  description     String
  // linked intelligence event that triggered this investigation
  intelligenceEventId String?
  triggerSource   String   // citizen_report | digital_twin | satellite_change | cv_detection | ai_observation | fraud_alert | manual
  triggerDescription String?
  // location
  lat             Float?
  lng             Float?
  locationName    String?
  region          String?
  // investigation status
  // triggered → gathering_context → analyzing_imagery → identifying_impacts → requesting_evidence → reasoning → monitoring → concluded
  status          String   @default("triggered")
  currentPhase    String   @default("triggered")
  // confidence (Bayesian — updates as new evidence arrives)
  confidence      Float    @default(0.5) // 0.0 (not credible) → 1.0 (highly credible)
  confidenceLevel String   @default("uncertain") // very_low | low | uncertain | moderate | high | very_high
  confidenceTrend String   @default("stable") // increasing | decreasing | stable
  // AI reasoning
  credibilityAssessment String? // human-readable explanation of why the event is/isn't credible
  reasoningChain  String?  // JSON: array of reasoning steps
  // evidence gathered
  historicalEventsFound Int @default(0)
  satelliteChangesDetected Int @default(0)
  affectedEntitiesCount Int @default(0)
  evidenceRequested Int @default(0)
  evidenceReceived  Int @default(0)
  // action recommendation
  recommendedAction String? // dispatch_inspector | request_drone | wait_for_corroboration | escalate | dismiss | monitor
  actionReasoning  String?
  actionConfidence Float?
  // linked entities (JSON arrays)
  nearbyEventIds   String?  // JSON
  affectedEntityIds String? // JSON
  missionIds       String?  // JSON — auto-created missions
  satelliteSceneIds String? // JSON — compared scenes
  // AI model
  model            String   @default("auto-investigator-v1")
  // timing
  triggeredAt      DateTime @default(now())
  lastUpdated      DateTime @default(now())
  concludedAt      DateTime?
  // metadata
  metadata         String?  // JSON
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  phases           InvestigationPhase[]
  evidenceRequests EvidenceRequest[]
  confidenceUpdates ConfidenceUpdate[]
  recommendations  ActionRecommendation[]

  @@index([status])
  @@index([currentPhase])
  @@index([confidenceLevel])
  @@index([triggerSource])
  @@index([region])
  @@index([triggeredAt])
  @@index([confidence])
}

model InvestigationPhase {
  id              String   @id @default(cuid())
  investigationId String
  // phase: triggered | gathering_context | analyzing_imagery | identifying_impacts | requesting_evidence | reasoning | monitoring | concluded
  phase           String
  title           String
  description     String
  // results
  findings        String?  // JSON — what the AI found in this phase
  durationMs      Int?
  // status
  status          String   @default("pending") // pending | in_progress | completed | failed
  // timing
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  investigation   AutonomousInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId])
  @@index([phase])
  @@index([status])
}

model EvidenceRequest {
  id              String   @id @default(cuid())
  investigationId String
  // what evidence is being requested
  requestType     String   // photo | video | water_sample | gps_verification | witness_statement | drone_footage
  description     String
  // who is being asked
  targetUserId    String?
  targetUserName  String?
  targetTrustTier String?
  distanceKm      Float?   // distance from the user to the event location
  // linked mission (if a mission was auto-created)
  missionId       String?
  // status
  status          String   @default("pending") // pending | accepted | submitted | verified | declined | expired
  // result
  submittedAt     DateTime?
  evidenceId      String?  // evidence ID if submitted
  qualityScore    Float?   // quality of submitted evidence
  // timing
  requestedAt     DateTime @default(now())
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  investigation   AutonomousInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId])
  @@index([status])
  @@index([requestType])
}

model ConfidenceUpdate {
  id              String   @id @default(cuid())
  investigationId String
  // previous and new confidence
  previousConfidence Float
  newConfidence      Float
  delta              Float  // change (+ or -)
  // what caused the update
  trigger         String   // evidence_received | satellite_analyzed | mission_completed | corroboration_added | fraud_detected | time_decay | initial
  description     String
  // Bayesian factors
  priorProbability Float?
  likelihoodRatio  Float?
  posteriorProbability Float?
  // timing
  updatedAt        DateTime @default(now())
  createdAt        DateTime @default(now())

  investigation   AutonomousInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId])
  @@index([trigger])
  @@index([updatedAt])
}

model ActionRecommendation {
  id              String   @id @default(cuid())
  investigationId String
  // recommended action
  action          String   // dispatch_inspector | request_drone | wait_for_corroboration | escalate | dismiss | monitor | request_lab_analysis | notify_agency
  priority        String   @default("medium") // low | medium | high | urgent
  title           String
  reasoning       String
  // confidence in the recommendation
  confidence      Float    @default(0.7)
  // expected impact
  expectedOutcome String?
  // status
  status          String   @default("pending") // pending | accepted | rejected | executed
  executedAt      DateTime?
  executedById    String?
  executionNotes  String?
  // timing
  recommendedAt   DateTime @default(now())
  createdAt       DateTime @default(now())

  investigation   AutonomousInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId])
  @@index([action])
  @@index([status])
  @@index([priority])
}

// =============================================================================
// AUTH — Waitlist (community signup requests awaiting admin approval)
// =============================================================================

model WaitlistEntry {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  passwordHash    String   // pre-hashed password from signup, used when admin approves
  organization    String?
  roleInterest    String   @default("citizen_reporter")
  status          String   @default("pending") // pending | approved | rejected
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNotes     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}
